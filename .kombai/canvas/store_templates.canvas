    },
    "var_cb692f011d31": {
      "type": "variant",
      "label": "Landing real — dirección editorial",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4460,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700;800&display=swap');\n  :root { --paper:#f4f1eb; --ink:#14221e; --muted:#68716b; --line:#d8d5cd; --green:#254f3b; --lime:#dfe8d7; --terracotta:#b85d38; --cream:#fffdf9; --dark:#14221e; }\n  body { margin:0; background:var(--paper); color:var(--ink); font-family:Inter, sans-serif; }\n  .serif { font-family:'DM Serif Display', Georgia, serif; }\n  .eyebrow { letter-spacing:.18em; text-transform:uppercase; font-size:11px; font-weight:800; }\n  .rule { border-top:1px solid var(--line); }\n  .shadow-soft { box-shadow:0 18px 60px rgba(20,34,30,.11); }\n  .shadow-phone { box-shadow:0 22px 55px rgba(20,34,30,.24), 0 0 0 8px #18211f, 0 0 0 10px #73817b; }\n  .phone { border-radius:36px; overflow:hidden; background:#17211e; border:8px solid #18211f; box-shadow:0 0 0 2px #71817c, 0 28px 55px rgba(20,34,30,.25); }\n  .phone img { display:block; width:100%; height:100%; object-fit:cover; object-position:top; transform:scale(1.08); transform-origin:top center; }\n  .store-image { display:block; width:100%; height:100%; object-fit:cover; object-position:top; }\n  details summary { cursor:pointer; list-style:none; }\n  details summary::-webkit-details-marker { display:none; }\n  details[open] summary .plus { transform:rotate(45deg); }\n  @media (max-width: 800px) {\n    .hero-grid,.split-grid,.buy-grid,.admin-grid,.case-grid { grid-template-columns:1fr !important; }\n    .hero-copy { order:1; }\n    .hero-proof { order:2; }\n    .collage { grid-template-columns:1fr !important; }\n    .collage-main { min-height:320px !important; }\n    .collage-side { grid-template-columns:1fr 1fr !important; }\n    .pricing-grid { grid-template-columns:1fr !important; }\n    .footer-grid { grid-template-columns:1fr 1fr !important; }\n    .nav-links { display:none; }\n    .mobile-hide { display:none; }\n  }\n</style>\n<div class=\"min-h-screen bg-[var(--paper)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <nav class=\"sticky top-0 z-20 border-b border-[#d8d5cd]/80 bg-[#f4f1eb]/90 backdrop-blur-md\" data-kid=\"1-1\" data-name=\"sticky navigation bar\">\n        <div class=\"mx-auto flex max-w-[1180px] items-center justify-between px-6 py-5\" data-kid=\"1-1-1\" data-name=\"navigation content wrapper\">\n            <a class=\"flex items-center gap-3 no-underline text-[var(--ink)]\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#top\">\n                <span class=\"serif text-[25px] leading-none\" data-kid=\"1-1-1-1-1\" data-name=\"brand name text\">\n                    Shop\n                </span>\n                <span class=\"rounded-full bg-[var(--green)] px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[.15em] text-white\" data-kid=\"1-1-1-1-2\" data-name=\"saas label badge\">\n                    SaaS\n                </span>\n            </a>\n            <div class=\"nav-links flex items-center gap-8 text-[12px] font-semibold text-[#58625c]\" data-kid=\"1-1-1-2\" data-name=\"navigation links container\">\n                <a class=\"no-underline text-inherit\" data-kid=\"1-1-1-2-1\" data-name=\"real examples link\" href=\"#ejemplos\">\n                    Ejemplos reales\n                </a>\n                <a class=\"no-underline text-inherit\" data-kid=\"1-1-1-2-2\" data-name=\"personalization link\" href=\"#personaliza\">\n                    Personalización\n                </a>\n                <a class=\"no-underline text-inherit\" data-kid=\"1-1-1-2-3\" data-name=\"how it works link\" href=\"#flujo\">\n                    Cómo compran\n                </a>\n                <a class=\"no-underline text-inherit\" data-kid=\"1-1-1-2-4\" data-name=\"plans link\" href=\"#planes\">\n                    Planes\n                </a>\n            </div>\n            <a class=\"rounded-full bg-[var(--green)] px-5 py-3 text-[12px] font-bold text-white no-underline shadow-sm\" data-kid=\"1-1-1-3\" data-name=\"create shop call-to-action button\" href=\"#cta\">\n                Crear mi tienda\n            </a>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main page content\" id=\"top\">\n        <section class=\"mx-auto max-w-[1180px] px-6 pb-20 pt-20 lg:pt-28\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"hero-grid grid grid-cols-[.76fr_1.24fr] items-center gap-14\" data-kid=\"1-2-1-1\" data-name=\"hero layout grid\">\n                <div class=\"hero-copy\" data-kid=\"1-2-1-1-1\" data-name=\"hero copy column\">\n                    <div class=\"mb-7 flex items-center gap-3\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero eyebrow container\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--terracotta)]\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"eyebrow decorative dot\">\n                        </span>\n                        <span class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"hero eyebrow text\">\n                            Producto real · tiendas reales\n                        </span>\n                    </div>\n                    <h1 class=\"serif max-w-[520px] text-[58px] leading-[.98] tracking-[-.03em] text-[var(--ink)] lg:text-[76px]\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero main headline\">\n                        Creá una tienda que se parezca a\n                        <span class=\"text-[var(--terracotta)]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"hero headline emphasized text\">\n                            tu marca.\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[470px] text-[17px] leading-8 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero description text\">\n                        Una plataforma para vender productos, servicios y colecciones con una experiencia propia. Así puede quedar tu tienda cuando la marca está al frente.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-4\" data-kid=\"1-2-1-1-1-4\" data-name=\"hero call-to-action buttons group\">\n                        <a class=\"rounded-full bg-[var(--green)] px-6 py-4 text-[13px] font-bold text-white no-underline\" data-kid=\"1-2-1-1-1-4-1\" data-name=\"view real stores button\" href=\"#ejemplos\">\n                            Ver tiendas reales\n                        </a>\n                        <a class=\"rounded-full border border-[var(--green)] px-6 py-4 text-[13px] font-bold text-[var(--green)] no-underline\" data-kid=\"1-2-1-1-1-4-2\" data-name=\"how it works button\" href=\"#como-se-crea\">\n                            Cómo se crea\n                        </a>\n                    </div>\n                    <div class=\"mt-12 flex max-w-[440px] items-start gap-8 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-1-1-1-5\" data-name=\"hero info stats bar\">\n                        <div data-kid=\"1-2-1-1-1-5-1\" data-name=\"hero stats column one\">\n                            <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-1-1-1-5-1-1\" data-name=\"hero stat label one\">\n                                4 rubros\n                            </div>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-5-1-2\" data-name=\"hero stat description one\">\n                                Moda, productos creativos, fiestas y artículos artesanales.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-1-1-1-5-2\" data-name=\"hero stats column two\">\n                            <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-1-1-1-5-2-1\" data-name=\"hero stat label two\">\n                                1 plataforma\n                            </div>\n                            <p class=\"mt-2 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-1-1-1-5-2-2\" data-name=\"hero stat description two\">\n                                Catálogo, carrito, pedidos y personalización.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"hero-proof relative\" data-kid=\"1-2-1-1-2\" data-name=\"hero proof image container\">\n                    <div class=\"absolute -left-5 top-8 z-10 rounded-full border border-[var(--line)] bg-[var(--cream)] px-4 py-2 text-[11px] font-bold text-[var(--green)] shadow-sm\" data-kid=\"1-2-1-1-2-1\" data-name=\"proof example label badge\">\n                        Ejemplo real · Del Mate\n                    </div>\n                    <div class=\"shadow-soft overflow-hidden rounded-[28px] border border-[#d8d5cd] bg-[#1d201a]\" data-kid=\"1-2-1-1-2-2\" data-name=\"proof image wrapper\">\n                        <img alt=\"Tienda real Del Mate con portada fotográfica y catálogo\" class=\"store-image h-[480px] lg:h-[575px]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"proof storefront image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%202/pc%20%20Diseno%20moderno/Screenshot_5.png\"/>\n                    </div>\n                    <div class=\"absolute -bottom-7 -left-8 max-w-[235px] rounded-2xl bg-[var(--cream)] p-4 shadow-soft\" data-kid=\"1-2-1-1-2-3\" data-name=\"proof testimonial box\">\n                        <div class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-1-1-2-3-1\" data-name=\"proof testimonial label\">\n                            La prueba\n                        </div>\n                        <p class=\"mt-2 text-[13px] font-semibold leading-5 text-[var(--ink)]\" data-kid=\"1-2-1-1-2-3-2\" data-name=\"proof testimonial text\">\n                            Una portada, una paleta y una forma de vender que ya tienen identidad.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[var(--line)] bg-[#ebe7df] py-5\" data-kid=\"1-2-2\" data-name=\"proof points highlight bar\">\n            <div class=\"mx-auto flex max-w-[1180px] flex-wrap items-center justify-center gap-x-10 gap-y-3 px-6 text-center text-[11px] font-bold uppercase tracking-[.16em] text-[var(--green)]\" data-kid=\"1-2-2-1\" data-name=\"proof points list container\">\n                <span data-kid=\"1-2-2-1-1\" data-name=\"proof point one\">\n                    Tiendas reales\n                </span>\n                <span class=\"text-[var(--terracotta)]\" data-kid=\"1-2-2-1-2\" data-name=\"point separator dot one\">\n                    •\n                </span>\n                <span data-kid=\"1-2-2-1-3\" data-name=\"proof point two\">\n                    Productos reales\n                </span>\n                <span class=\"text-[var(--terracotta)]\" data-kid=\"1-2-2-1-4\" data-name=\"point separator dot two\">\n                    •\n                </span>\n                <span data-kid=\"1-2-2-1-5\" data-name=\"proof point three\">\n                    Experiencias de compra reales\n                </span>\n                <span class=\"text-[var(--terracotta)]\" data-kid=\"1-2-2-1-6\" data-name=\"point separator dot three\">\n                    •\n                </span>\n                <span data-kid=\"1-2-2-1-7\" data-name=\"proof point four\">\n                    Una marca distinta en cada pantalla\n                </span>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1180px] px-6 py-28\" data-kid=\"1-2-3\" data-name=\"examples section\" id=\"ejemplos\">\n            <div class=\"max-w-[690px]\" data-kid=\"1-2-3-1\" data-name=\"examples header content\">\n                <div class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-3-1-1\" data-name=\"examples eyebrow text\">\n                    Ejemplos de resultado\n                </div>\n                <h2 class=\"serif mt-4 text-[48px] leading-[1.02] tracking-[-.025em] lg:text-[65px]\" data-kid=\"1-2-3-1-2\" data-name=\"examples section headline\">\n                    No todas las tiendas tienen que verse iguales.\n                </h2>\n                <p class=\"mt-6 max-w-[570px] text-[16px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-3-1-3\" data-name=\"examples section description\">\n                    La plataforma se adapta al rubro, a los productos y a la forma en que cada negocio quiere presentarse.\n                </p>\n            </div>\n            <div class=\"collage mt-14 grid grid-cols-[1.18fr_.82fr] gap-5\" data-kid=\"1-2-3-2\" data-name=\"examples collage grid\">\n                <div class=\"collage-main group relative min-h-[600px] overflow-hidden rounded-[24px] bg-[#1d201a]\" data-kid=\"1-2-3-2-1\" data-name=\"collage main store image card\">\n                    <img alt=\"Del Mate con categorías y productos\" class=\"store-image absolute inset-0 transition duration-500 group-hover:scale-[1.02]\" data-kid=\"1-2-3-2-1-1\" data-name=\"main store example image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%202/pc%20%20Diseno%20moderno/Screenshot_1.png\"/>\n                    <div class=\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-[#14221e]/90 to-transparent p-7 pt-24\" data-kid=\"1-2-3-2-1-2\" data-name=\"main store description overlay\">\n                        <span class=\"eyebrow text-[#e8d9b7]\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"main store category label\">\n                            Marca editorial\n                        </span>\n                        <p class=\"serif mt-2 text-[28px] text-white\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"main store description headline\">\n                            Colecciones que se sienten propias.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"collage-side grid grid-rows-[1fr_1fr] gap-5\" data-kid=\"1-2-3-2-2\" data-name=\"collage side layout grid\">\n                    <div class=\"relative min-h-[270px] overflow-hidden rounded-[24px] bg-[#b4d8fb]\" data-kid=\"1-2-3-2-2-1\" data-name=\"side store card one\">\n                        <img alt=\"Tukito con productos 3D y categorías\" class=\"store-image\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"side store example image one\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%203/pc%20Diseno%20clasico/principal.png\"/>\n                        <div class=\"absolute bottom-4 left-4 rounded-full bg-white/95 px-3 py-2 text-[11px] font-bold text-[var(--ink)]\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"side store example category label\">\n                            Productos creativos\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-5\" data-kid=\"1-2-3-2-2-2\" data-name=\"side store mobile grid\">\n                        <div class=\"phone min-h-[310px]\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"side mobile store card one\">\n                            <img alt=\"Glitter Show en versión mobile\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"side mobile example image one\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio1/mobile%20Diseno%20comercial/Screenshot_1.png\"/>\n                        </div>\n                        <div class=\"phone min-h-[310px]\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"side mobile store card two\">\n                            <img alt=\"Vibra Complementos en versión mobile\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"side mobile example image two\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%204/mobile%20diseno%20clasico/principal.png\"/>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-[var(--line)] pt-5 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-3\" data-name=\"store credits bar\">\n                <span data-kid=\"1-2-3-3-1\" data-name=\"credit one\">\n                    <strong class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-1-1\" data-name=\"credit store name one\">\n                        Del Mate\n                    </strong>\n                    · artículos artesanales\n                </span>\n                <span data-kid=\"1-2-3-3-2\" data-name=\"credit two\">\n                    <strong class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-2-1\" data-name=\"credit store name two\">\n                        Tukito\n                    </strong>\n                    · productos 3D\n                </span>\n                <span data-kid=\"1-2-3-3-3\" data-name=\"credit three\">\n                    <strong class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-3-1\" data-name=\"credit store name three\">\n                        Glitter Show\n                    </strong>\n                    · fiestas y eventos\n                </span>\n                <span data-kid=\"1-2-3-3-4\" data-name=\"credit four\">\n                    <strong class=\"text-[var(--ink)]\" data-kid=\"1-2-3-3-4-1\" data-name=\"credit store name four\">\n                        Vibra\n                    </strong>\n                    · moda y complementos\n                </span>\n            </div>\n        </section>\n        <section class=\"bg-[var(--dark)] py-28 text-white\" data-kid=\"1-2-4\" data-name=\"personalization section\" id=\"personaliza\">\n            <div class=\"admin-grid mx-auto grid max-w-[1180px] grid-cols-[.8fr_1.2fr] items-center gap-16 px-6\" data-kid=\"1-2-4-1\" data-name=\"personalization grid\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"personalization copy\">\n                    <div class=\"eyebrow text-[#d8b17b]\" data-kid=\"1-2-4-1-1-1\" data-name=\"personalization eyebrow text\">\n                        Del panel al resultado\n                    </div>\n                    <h2 class=\"serif mt-4 text-[48px] leading-[1.02] tracking-[-.025em] lg:text-[62px]\" data-kid=\"1-2-4-1-1-2\" data-name=\"personalization section headline\">\n                        Personalizá el resultado, no sólo el catálogo.\n                    </h2>\n                    <p class=\"mt-6 max-w-[440px] text-[16px] leading-7 text-[#bbc6bf]\" data-kid=\"1-2-4-1-1-3\" data-name=\"personalization section description\">\n                        Elegí colores, logo, portada y fondo. Después, esos controles se convierten en una tienda con una identidad propia.\n                    </p>\n                    <div class=\"mt-9 flex items-center gap-3 text-[12px] font-bold text-[#d8b17b]\" data-kid=\"1-2-4-1-1-4\" data-name=\"personalization process steps\">\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full border border-[#d8b17b]\" data-kid=\"1-2-4-1-1-4-1\" data-name=\"process step number one\">\n                            1\n                        </span>\n                        <span data-kid=\"1-2-4-1-1-4-2\" data-name=\"process step text one\">\n                            Configurás tu marca\n                        </span>\n                        <span class=\"h-px w-10 bg-[#d8b17b]/60\" data-kid=\"1-2-4-1-1-4-3\" data-name=\"process step separator line\">\n                        </span>\n                        <span class=\"flex h-8 w-8 items-center justify-center rounded-full border border-[#d8b17b]\" data-kid=\"1-2-4-1-1-4-4\" data-name=\"process step number two\">\n                            2\n                        </span>\n                        <span data-kid=\"1-2-4-1-1-4-5\" data-name=\"process step text two\">\n                            Publicás tu tienda\n                        </span>\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-[1fr_.62fr] items-center gap-6\" data-kid=\"1-2-4-1-2\" data-name=\"personalization visual examples\">\n                    <div class=\"overflow-hidden rounded-[22px] border border-white/15 bg-white shadow-2xl\" data-kid=\"1-2-4-1-2-1\" data-name=\"dashboard view card\">\n                        <img alt=\"Panel real de personalización de colores, logo e imagen de portada\" class=\"block h-[330px] w-full object-cover object-top\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"dashboard view image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/adminDash/Screenshot_3.png\"/>\n                    </div>\n                    <div class=\"phone h-[370px]\" data-kid=\"1-2-4-1-2-2\" data-name=\"mobile preview phone\">\n                        <img alt=\"Resultado real de una tienda personalizable\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"mobile preview store image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%204/mobile%20diseno%20clasico/principal.png\"/>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1180px] px-6 py-28\" data-kid=\"1-2-5\" data-name=\"flow section\" id=\"flujo\">\n            <div class=\"flex flex-wrap items-end justify-between gap-8\" data-kid=\"1-2-5-1\" data-name=\"flow header content\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"flow eyebrow text\">\n                    <div class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-5-1-1-1\">\n                        Experiencia de compra\n                    </div>\n                    <h2 class=\"serif mt-4 max-w-[650px] text-[48px] leading-[1.02] tracking-[-.025em] lg:text-[63px]\" data-kid=\"1-2-5-1-1-2\">\n                        Del catálogo al pedido, sin perder la marca.\n                    </h2>\n                </div>\n                <p class=\"max-w-[310px] text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-5-1-2\" data-name=\"flow section headline\">\n                    Cada captura demuestra una parte concreta del recorrido de tu cliente.\n                </p>\n            </div>\n            <div class=\"buy-grid mt-14 grid grid-cols-3 gap-5\" data-kid=\"1-2-5-2\" data-name=\"buying flow grid\">\n                <div data-kid=\"1-2-5-2-1\" data-name=\"step one card\">\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-2-5-2-1-1\" data-name=\"step one header\">\n                        <span class=\"serif text-[32px] text-[var(--terracotta)]\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"step one number\">\n                            01\n                        </span>\n                        <span class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-5-2-1-1-2\" data-name=\"step one label\">\n                            Catálogo\n                        </span>\n                    </div>\n                    <div class=\"overflow-hidden rounded-[22px] border border-[var(--line)] bg-white shadow-soft\" data-kid=\"1-2-5-2-1-2\" data-name=\"step one image wrapper\">\n                        <img alt=\"Catálogo mobile real con productos, precios y stock\" class=\"block h-[390px] w-full object-cover object-top\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"step one example image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%204/mobile%20diseno%20clasico/catalogo%27.png\"/>\n                    </div>\n                    <p class=\"mt-4 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-5-2-1-3\" data-name=\"step one description\">\n                        Productos, precios, stock y llamados a la acción visibles desde el celular.\n                    </p>\n                </div>\n                <div data-kid=\"1-2-5-2-2\" data-name=\"step two card\">\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-2-5-2-2-1\" data-name=\"step two header\">\n                        <span class=\"serif text-[32px] text-[var(--terracotta)]\" data-kid=\"1-2-5-2-2-1-1\" data-name=\"step two number\">\n                            02\n                        </span>\n                        <span class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"step two label\">\n                            Detalle\n                        </span>\n                    </div>\n                    <div class=\"overflow-hidden rounded-[22px] border border-[var(--line)] bg-white shadow-soft\" data-kid=\"1-2-5-2-2-2\" data-name=\"step two image wrapper\">\n                        <img alt=\"Detalle de producto real con descripción, stock y botón de compra\" class=\"block h-[390px] w-full object-cover object-top\" data-kid=\"1-2-5-2-2-2-1\" data-name=\"step two example image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%204/mobile%20diseno%20clasico/modalproducto.png\"/>\n                    </div>\n                    <p class=\"mt-4 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-5-2-2-3\" data-name=\"step two description\">\n                        Una ficha de producto que explica, muestra y permite comprar.\n                    </p>\n                </div>\n                <div data-kid=\"1-2-5-2-3\" data-name=\"step three card\">\n                    <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-2-5-2-3-1\" data-name=\"step three header\">\n                        <span class=\"serif text-[32px] text-[var(--terracotta)]\" data-kid=\"1-2-5-2-3-1-1\" data-name=\"step three number\">\n                            03\n                        </span>\n                        <span class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-5-2-3-1-2\" data-name=\"step three label\">\n                            Checkout\n                        </span>\n                    </div>\n                    <div class=\"overflow-hidden rounded-[22px] border border-[var(--line)] bg-white shadow-soft\" data-kid=\"1-2-5-2-3-2\" data-name=\"step three image wrapper\">\n                        <img alt=\"Checkout mobile real con WhatsApp y Mercado Pago\" class=\"block h-[390px] w-full object-cover object-top\" data-kid=\"1-2-5-2-3-2-1\" data-name=\"step three example image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%203/mobile/compraConmercadoPago.png\"/>\n                    </div>\n                    <p class=\"mt-4 text-[13px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-5-2-3-3\" data-name=\"step three description\">\n                        Pedido por WhatsApp o pago con Mercado Pago desde una experiencia responsive.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[var(--line)] bg-[#ebe7df] py-28\" data-kid=\"1-2-6\" data-name=\"how it works platform section\" id=\"como-se-crea\">\n            <div class=\"mx-auto max-w-[1180px] px-6\" data-kid=\"1-2-6-1\" data-name=\"platform layout container\">\n                <div class=\"max-w-[650px]\" data-kid=\"1-2-6-1-1\" data-name=\"platform section header\">\n                    <div class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-6-1-1-1\" data-name=\"platform eyebrow text\">\n                        Una plataforma para operar\n                    </div>\n                    <h2 class=\"serif mt-4 text-[48px] leading-[1.02] tracking-[-.025em] lg:text-[62px]\" data-kid=\"1-2-6-1-1-2\" data-name=\"platform section headline\">\n                        La tienda que ve tu cliente y el panel que usás vos.\n                    </h2>\n                </div>\n                <div class=\"mt-14 grid grid-cols-4 gap-x-8 gap-y-12\" data-kid=\"1-2-6-1-2\" data-name=\"platform feature cards grid\">\n                    <div data-kid=\"1-2-6-1-2-1\" data-name=\"feature card sell\">\n                        <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"feature label sell\">\n                            Vender\n                        </div>\n                        <h3 class=\"mt-3 text-[21px] font-bold\" data-kid=\"1-2-6-1-2-1-2\" data-name=\"feature headline sell\">\n                            Mostrá lo que hacés.\n                        </h3>\n                        <p class=\"mt-3 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-6-1-2-1-3\" data-name=\"feature description sell\">\n                            Catálogo, categorías, imágenes, precios, stock y productos destacados.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-6-1-2-2\" data-name=\"feature card collect\">\n                        <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-6-1-2-2-1\" data-name=\"feature label collect\">\n                            Cobrar\n                        </div>\n                        <h3 class=\"mt-3 text-[21px] font-bold\" data-kid=\"1-2-6-1-2-2-2\" data-name=\"feature headline collect\">\n                            Recibí el pedido.\n                        </h3>\n                        <p class=\"mt-3 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-6-1-2-2-3\" data-name=\"feature description collect\">\n                            WhatsApp, Mercado Pago y opciones de entrega visibles para tu cliente.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-6-1-2-3\" data-name=\"feature card manage\">\n                        <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-6-1-2-3-1\" data-name=\"feature label manage\">\n                            Administrar\n                        </div>\n                        <h3 class=\"mt-3 text-[21px] font-bold\" data-kid=\"1-2-6-1-2-3-2\" data-name=\"feature headline manage\">\n                            Ordená tu operación.\n                        </h3>\n                        <p class=\"mt-3 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-3\" data-name=\"feature description manage\">\n                            Gestioná productos y categorías desde un solo panel.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-6-1-2-4\" data-name=\"feature card grow\">\n                        <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-6-1-2-4-1\" data-name=\"feature label grow\">\n                            Crecer\n                        </div>\n                        <h3 class=\"mt-3 text-[21px] font-bold\" data-kid=\"1-2-6-1-2-4-2\" data-name=\"feature headline grow\">\n                            Construí una marca.\n                        </h3>\n                        <p class=\"mt-3 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-6-1-2-4-3\" data-name=\"feature description grow\">\n                            Convertí colores, logo y portada en una experiencia reconocible.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"admin-grid mt-16 grid grid-cols-2 gap-5\" data-kid=\"1-2-6-1-3\" data-name=\"platform feature dashboard images\">\n                    <div class=\"overflow-hidden rounded-[22px] border border-white bg-white shadow-soft\" data-kid=\"1-2-6-1-3-1\" data-name=\"products dashboard card\">\n                        <img alt=\"Panel real de productos con precios y stock\" class=\"block h-[260px] w-full object-cover object-top\" data-kid=\"1-2-6-1-3-1-1\" data-name=\"products dashboard image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/adminDash/Screenshot_1.png\"/>\n                        <div class=\"border-t border-[var(--line)] px-5 py-4 text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-6-1-3-1-2\" data-name=\"products dashboard caption\">\n                            Panel de productos · precio y stock\n                        </div>\n                    </div>\n                    <div class=\"overflow-hidden rounded-[22px] border border-white bg-white shadow-soft\" data-kid=\"1-2-6-1-3-2\" data-name=\"categories dashboard card\">\n                        <img alt=\"Panel real de categorías y visibilidad\" class=\"block h-[260px] w-full object-cover object-top\" data-kid=\"1-2-6-1-3-2-1\" data-name=\"categories dashboard image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/adminDash/Screenshot_2.png\"/>\n                        <div class=\"border-t border-[var(--line)] px-5 py-4 text-[12px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-6-1-3-2-2\" data-name=\"categories dashboard caption\">\n                            Panel de categorías · orden y visibilidad\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1180px] px-6 py-28\" data-kid=\"1-2-7\" data-name=\"pricing plans section\" id=\"planes\">\n            <div class=\"flex flex-wrap items-end justify-between gap-8\" data-kid=\"1-2-7-1\" data-name=\"pricing section header\">\n                <div data-kid=\"1-2-7-1-1\" data-name=\"pricing eyebrow text\">\n                    <div class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-7-1-1-1\" data-name=\"pricing section headline\">\n                        Planes\n                    </div>\n                    <h2 class=\"serif mt-4 text-[48px] leading-[1.02] tracking-[-.025em] lg:text-[62px]\" data-kid=\"1-2-7-1-1-2\">\n                        Empezá con lo que necesitás.\n                    </h2>\n                </div>\n                <p class=\"max-w-[300px] text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-7-1-2\" data-name=\"pricing section description\">\n                    Precios claros para empezar, validar y crecer sin rehacer tu tienda.\n                </p>\n            </div>\n            <div class=\"pricing-grid mt-14 grid grid-cols-3 gap-5\" data-kid=\"1-2-7-2\" data-name=\"pricing plans grid\">\n                <div class=\"rounded-[22px] border border-[var(--line)] bg-[var(--cream)] p-7\" data-kid=\"1-2-7-2-1\" data-name=\"starter plan card\">\n                    <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-7-2-1-1\" data-name=\"starter plan label\">\n                        Emprendedor\n                    </div>\n                    <p class=\"mt-4 text-[14px] text-[var(--muted)]\" data-kid=\"1-2-7-2-1-2\" data-name=\"starter plan description\">\n                        Para empezar a vender.\n                    </p>\n                    <div class=\"serif mt-7 text-[44px]\" data-kid=\"1-2-7-2-1-3\" data-name=\"starter plan price\">\n                        Gratis\n                    </div>\n                    <ul class=\"mt-7 space-y-3 border-t border-[var(--line)] pt-5 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-7-2-1-4\" data-name=\"starter plan features list\">\n                        <li data-kid=\"1-2-7-2-1-4-1\" data-name=\"starter plan feature one\">\n                            ✓ Tienda online\n                        </li>\n                        <li data-kid=\"1-2-7-2-1-4-2\" data-name=\"starter plan feature two\">\n                            ✓ Productos y categorías\n                        </li>\n                        <li data-kid=\"1-2-7-2-1-4-3\" data-name=\"starter plan feature three\">\n                            ✓ Carrito de compras\n                        </li>\n                        <li data-kid=\"1-2-7-2-1-4-4\" data-name=\"starter plan feature four\">\n                            ✓ Diseño personalizable\n                        </li>\n                    </ul>\n                    <a class=\"mt-8 block rounded-full border border-[var(--green)] py-3 text-center text-[12px] font-bold text-[var(--green)] no-underline\" data-kid=\"1-2-7-2-1-5\" data-name=\"starter plan call-to-action button\" href=\"#cta\">\n                        Empezar gratis\n                    </a>\n                </div>\n                <div class=\"rounded-[22px] bg-[var(--green)] p-7 text-white shadow-soft\" data-kid=\"1-2-7-2-2\" data-name=\"pro plan card\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-7-2-2-1\" data-name=\"pro plan header\">\n                        <div class=\"eyebrow text-[#d8b17b]\" data-kid=\"1-2-7-2-2-1-1\" data-name=\"pro plan label\">\n                            Profesional\n                        </div>\n                        <span class=\"rounded-full bg-[#d8b17b] px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-[var(--ink)]\" data-kid=\"1-2-7-2-2-1-2\" data-name=\"pro plan badge\">\n                            Más elegido\n                        </span>\n                    </div>\n                    <p class=\"mt-4 text-[14px] text-[#c8d4cd]\" data-kid=\"1-2-7-2-2-2\" data-name=\"pro plan description\">\n                        Para negocios que quieren crecer.\n                    </p>\n                    <div class=\"serif mt-7 text-[44px]\" data-kid=\"1-2-7-2-2-3\" data-name=\"pro plan price\">\n                        $5.000\n                        <span class=\"font-sans text-[14px] text-[#c8d4cd]\" data-kid=\"1-2-7-2-2-3-1\" data-name=\"pro plan price interval\">\n                            / mes\n                        </span>\n                    </div>\n                    <ul class=\"mt-7 space-y-3 border-t border-white/20 pt-5 text-[13px] leading-5 text-[#e7eee9]\" data-kid=\"1-2-7-2-2-4\" data-name=\"pro plan features list\">\n                        <li data-kid=\"1-2-7-2-2-4-1\" data-name=\"pro plan feature one\">\n                            ✓ Todo lo del plan inicial\n                        </li>\n                        <li data-kid=\"1-2-7-2-2-4-2\" data-name=\"pro plan feature two\">\n                            ✓ Mercado Pago\n                        </li>\n                        <li data-kid=\"1-2-7-2-2-4-3\" data-name=\"pro plan feature three\">\n                            ✓ Promociones y ofertas\n                        </li>\n                        <li data-kid=\"1-2-7-2-2-4-4\" data-name=\"pro plan feature four\">\n                            ✓ Gestión avanzada de pedidos\n                        </li>\n                        <li data-kid=\"1-2-7-2-2-4-5\" data-name=\"pro plan feature five\">\n                            ✓ Marca propia y soporte prioritario\n                        </li>\n                    </ul>\n                    <a class=\"mt-8 block rounded-full bg-[#d8b17b] py-3 text-center text-[12px] font-bold text-[var(--ink)] no-underline\" data-kid=\"1-2-7-2-2-5\" data-name=\"pro plan call-to-action button\" href=\"#cta\">\n                        Crear mi tienda\n                    </a>\n                </div>\n                <div class=\"rounded-[22px] border border-[var(--line)] bg-[var(--cream)] p-7\" data-kid=\"1-2-7-2-3\" data-name=\"enterprise plan card\">\n                    <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-2-7-2-3-1\" data-name=\"enterprise plan label\">\n                        Empresarial\n                    </div>\n                    <p class=\"mt-4 text-[14px] text-[var(--muted)]\" data-kid=\"1-2-7-2-3-2\" data-name=\"enterprise plan description\">\n                        Para mayor volumen y necesidades propias.\n                    </p>\n                    <div class=\"serif mt-7 text-[44px]\" data-kid=\"1-2-7-2-3-3\" data-name=\"enterprise plan price\">\n                        A medida\n                    </div>\n                    <ul class=\"mt-7 space-y-3 border-t border-[var(--line)] pt-5 text-[13px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-7-2-3-4\" data-name=\"enterprise plan features list\">\n                        <li data-kid=\"1-2-7-2-3-4-1\" data-name=\"enterprise plan feature one\">\n                            ✓ Todo lo del plan profesional\n                        </li>\n                        <li data-kid=\"1-2-7-2-3-4-2\" data-name=\"enterprise plan feature two\">\n                            ✓ Múltiples usuarios\n                        </li>\n                        <li data-kid=\"1-2-7-2-3-4-3\" data-name=\"enterprise plan feature three\">\n                            ✓ Reportes avanzados\n                        </li>\n                        <li data-kid=\"1-2-7-2-3-4-4\" data-name=\"enterprise plan feature four\">\n                            ✓ Integraciones personalizadas\n                        </li>\n                    </ul>\n                    <a class=\"mt-8 block rounded-full border border-[var(--green)] py-3 text-center text-[12px] font-bold text-[var(--green)] no-underline\" data-kid=\"1-2-7-2-3-5\" data-name=\"enterprise plan call-to-action button\" href=\"#cta\">\n                        Hablar con nosotros\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#ebe7df] py-28\" data-kid=\"1-2-8\" data-name=\"case study section\">\n            <div class=\"case-grid mx-auto grid max-w-[1180px] grid-cols-[1.1fr_.9fr] items-center gap-16 px-6\" data-kid=\"1-2-8-1\" data-name=\"case study grid\">\n                <div class=\"overflow-hidden rounded-[25px] bg-[#1d201a] shadow-soft\" data-kid=\"1-2-8-1-1\" data-name=\"case study image wrapper\">\n                    <img alt=\"Caso real de tienda Del Mate\" class=\"block h-[400px] w-full object-cover object-top\" data-kid=\"1-2-8-1-1-1\" data-name=\"case study storefront image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%202/pc%20%20Diseno%20moderno/Screenshot_5.png\"/>\n                </div>\n                <div data-kid=\"1-2-8-1-2\" data-name=\"case study details\">\n                    <div class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-8-1-2-1\" data-name=\"case study eyebrow\">\n                        Caso real · Del Mate\n                    </div>\n                    <h2 class=\"serif mt-4 text-[45px] leading-[1.03] tracking-[-.025em]\" data-kid=\"1-2-8-1-2-2\" data-name=\"case study headline\">\n                        Una marca artesanal puede vender con una experiencia a su altura.\n                    </h2>\n                    <p class=\"mt-6 text-[15px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-8-1-2-3\" data-name=\"case study description\">\n                        La tienda combina una portada de marca, categorías visuales y un catálogo pensado para descubrir productos.\n                    </p>\n                    <div class=\"mt-8 border-l-2 border-[var(--terracotta)] pl-5 text-[14px] italic leading-6 text-[var(--ink)]\" data-kid=\"1-2-8-1-2-4\" data-name=\"case study testimonial quote\">\n                        “Testimonio real del comercio a incorporar aquí.”\n                        <div class=\"mt-2 not-italic text-[11px] font-bold uppercase tracking-[.12em] text-[var(--muted)]\" data-kid=\"1-2-8-1-2-4-1\" data-name=\"case study testimonial attribution\">\n                            Placeholder editorial · reemplazar con testimonio autorizado\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[850px] px-6 py-28\" data-kid=\"1-2-9\" data-name=\"faq section\">\n            <div class=\"text-center\" data-kid=\"1-2-9-1\" data-name=\"faq header\">\n                <div class=\"eyebrow text-[var(--terracotta)]\" data-kid=\"1-2-9-1-1\" data-name=\"faq eyebrow text\">\n                    Preguntas frecuentes\n                </div>\n                <h2 class=\"serif mt-4 text-[48px] leading-[1.02] tracking-[-.025em]\" data-kid=\"1-2-9-1-2\" data-name=\"faq section headline\">\n                    Antes de crear tu tienda.\n                </h2>\n            </div>\n            <div class=\"mt-12 divide-y divide-[var(--line)] border-y border-[var(--line)]\" data-kid=\"1-2-9-2\" data-name=\"faq list container\">\n                <details class=\"py-5\" data-kid=\"1-2-9-2-1\" data-name=\"faq question one\">\n                    <summary class=\"flex items-center justify-between gap-8 text-left text-[16px] font-semibold\" data-kid=\"1-2-9-2-1-1\" data-name=\"faq question summary one\">\n                        ¿Necesito saber programar?\n                        <span class=\"plus text-[26px] font-light text-[var(--terracotta)]\" data-kid=\"1-2-9-2-1-1-1\" data-name=\"faq plus icon one\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[650px] pt-4 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-2-1-2\" data-name=\"faq answer one\">\n                        No. La configuración de productos, categorías, colores, logo e imagen de portada se realiza desde el panel.\n                    </p>\n                </details>\n                <details class=\"py-5\" data-kid=\"1-2-9-2-2\" data-name=\"faq question two\">\n                    <summary class=\"flex items-center justify-between gap-8 text-left text-[16px] font-semibold\" data-kid=\"1-2-9-2-2-1\" data-name=\"faq question summary two\">\n                        ¿Puedo adaptar la tienda a mi rubro?\n                        <span class=\"plus text-[26px] font-light text-[var(--terracotta)]\" data-kid=\"1-2-9-2-2-1-1\" data-name=\"faq plus icon two\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[650px] pt-4 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-2-2-2\" data-name=\"faq answer two\">\n                        Sí. Los ejemplos reales muestran tiendas de moda, fiestas, productos 3D y artículos artesanales.\n                    </p>\n                </details>\n                <details class=\"py-5\" data-kid=\"1-2-9-2-3\" data-name=\"faq question three\">\n                    <summary class=\"flex items-center justify-between gap-8 text-left text-[16px] font-semibold\" data-kid=\"1-2-9-2-3-1\" data-name=\"faq question summary three\">\n                        ¿Cómo pueden pagar mis clientes?\n                        <span class=\"plus text-[26px] font-light text-[var(--terracotta)]\" data-kid=\"1-2-9-2-3-1-1\" data-name=\"faq plus icon three\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[650px] pt-4 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-2-3-2\" data-name=\"faq answer three\">\n                        Según la configuración disponible, pueden enviar el pedido por WhatsApp o pagar con Mercado Pago.\n                    </p>\n                </details>\n                <details class=\"py-5\" data-kid=\"1-2-9-2-4\" data-name=\"faq question four\">\n                    <summary class=\"flex items-center justify-between gap-8 text-left text-[16px] font-semibold\" data-kid=\"1-2-9-2-4-1\" data-name=\"faq question summary four\">\n                        ¿Puedo cambiar de plan?\n                        <span class=\"plus text-[26px] font-light text-[var(--terracotta)]\" data-kid=\"1-2-9-2-4-1-1\" data-name=\"faq plus icon four\">\n                            +\n                        </span>\n                    </summary>\n                    <p class=\"max-w-[650px] pt-4 text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-9-2-4-2\" data-name=\"faq answer four\">\n                        La información final sobre cambios, período de prueba y condiciones debe completarse con la oferta comercial vigente.\n                    </p>\n                </details>\n            </div>\n        </section>\n        <section class=\"px-6 pb-24\" data-kid=\"1-2-10\" data-name=\"footer call-to-action section\" id=\"cta\">\n            <div class=\"mx-auto max-w-[1180px] overflow-hidden rounded-[30px] bg-[var(--green)] px-8 py-20 text-center text-white lg:px-20\" data-kid=\"1-2-10-1\" data-name=\"cta section box\">\n                <div class=\"eyebrow text-[#d8b17b]\" data-kid=\"1-2-10-1-1\" data-name=\"cta eyebrow text\">\n                    Tu próximo paso\n                </div>\n                <h2 class=\"serif mx-auto mt-5 max-w-[750px] text-[52px] leading-[.98] tracking-[-.025em] lg:text-[72px]\" data-kid=\"1-2-10-1-2\" data-name=\"cta headline text\">\n                    Que tu tienda se vea como tu negocio.\n                </h2>\n                <p class=\"mx-auto mt-6 max-w-[550px] text-[16px] leading-7 text-[#d4ded7]\" data-kid=\"1-2-10-1-3\" data-name=\"cta description text\">\n                    Creala, personalizala y empezá a mostrar tus productos con una experiencia propia.\n                </p>\n                <a class=\"mt-9 inline-block rounded-full bg-[#d8b17b] px-7 py-4 text-[13px] font-bold text-[var(--ink)] no-underline\" data-kid=\"1-2-10-1-4\" data-name=\"footer cta button\" href=\"/registro\">\n                    Crear mi tienda gratis\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#d8d5cd] bg-[#ebe7df] px-6 py-10\" data-kid=\"1-3\" data-name=\"footer main container\">\n        <div class=\"footer-grid mx-auto grid max-w-[1180px] grid-cols-[2fr_1fr_1fr_1fr] gap-8\" data-kid=\"1-3-1\" data-name=\"footer grid\">\n            <div data-kid=\"1-3-1-1\" data-name=\"footer brand column\">\n                <div class=\"serif text-[25px]\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand name\">\n                    Shop\n                    <span class=\"font-sans text-[11px] font-extrabold uppercase tracking-widest text-[var(--terracotta)]\" data-kid=\"1-3-1-1-1-1\" data-name=\"footer saas label\">\n                        SaaS\n                    </span>\n                </div>\n                <p class=\"mt-3 max-w-[280px] text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-1-1-2\" data-name=\"footer brand description\">\n                    La plataforma para convertir tu catálogo y tu identidad en una tienda online real.\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\" data-name=\"footer product links column\">\n                <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-3-1-2-1\" data-name=\"footer product links header\">\n                    Producto\n                </div>\n                <div class=\"mt-4 space-y-2 text-[12px] text-[var(--muted)]\" data-kid=\"1-3-1-2-2\" data-name=\"footer product links group\">\n                    <div data-kid=\"1-3-1-2-2-1\" data-name=\"footer link one\">\n                        Ejemplos reales\n                    </div>\n                    <div data-kid=\"1-3-1-2-2-2\" data-name=\"footer link two\">\n                        Personalización\n                    </div>\n                    <div data-kid=\"1-3-1-2-2-3\" data-name=\"footer link three\">\n                        Planes\n                    </div>\n                </div>\n            </div>\n            <div data-kid=\"1-3-1-3\" data-name=\"footer resources links column\">\n                <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-3-1-3-1\" data-name=\"footer resources links header\">\n                    Recursos\n                </div>\n                <div class=\"mt-4 space-y-2 text-[12px] text-[var(--muted)]\" data-kid=\"1-3-1-3-2\" data-name=\"footer resources links group\">\n                    <div data-kid=\"1-3-1-3-2-1\" data-name=\"footer resource link one\">\n                        Cómo funciona\n                    </div>\n                    <div data-kid=\"1-3-1-3-2-2\" data-name=\"footer resource link two\">\n                        Preguntas frecuentes\n                    </div>\n                    <div data-kid=\"1-3-1-3-2-3\" data-name=\"footer resource link three\">\n                        Contacto\n                    </div>\n                </div>\n            </div>\n            <div data-kid=\"1-3-1-4\" data-name=\"footer legal links column\">\n                <div class=\"eyebrow text-[var(--green)]\" data-kid=\"1-3-1-4-1\" data-name=\"footer legal links header\">\n                    Legal\n                </div>\n                <div class=\"mt-4 space-y-2 text-[12px] text-[var(--muted)]\" data-kid=\"1-3-1-4-2\" data-name=\"footer legal links group\">\n                    <div data-kid=\"1-3-1-4-2-1\" data-name=\"footer legal link one\">\n                        Términos\n                    </div>\n                    <div data-kid=\"1-3-1-4-2-2\" data-name=\"footer legal link two\">\n                        Privacidad\n                    </div>\n                    <div data-kid=\"1-3-1-4-2-3\" data-name=\"footer legal link three\">\n                        Cookies\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-auto mt-8 max-w-[1180px] border-t border-[#d8d5cd] pt-5 text-[11px] text-[var(--muted)]\" data-kid=\"1-3-2\" data-name=\"footer copyright text\">\n            © 2026 Shop SaaS · Una propuesta visual basada en tiendas reales de la plataforma.\n        </div>\n    </footer>\n</div>\n",
