      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Barlow+Condensed:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .font-cond { font-family: 'Barlow Condensed', sans-serif; }\n  .font-osw { font-family: 'Oswald', sans-serif; }\n\n  .marquee-track { display:flex; white-space:nowrap; animation: marquee-scroll 22s linear infinite; }\n  .marquee-track:hover { animation-play-state: paused; }\n  @keyframes marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n\n  .flag-discount { clip-path: polygon(0 0, 100% 0, 100% 70%, 88% 100%, 0 100%); }\n  .flag-featured { clip-path: polygon(0 0, 100% 0, 100% 100%, 12% 100%, 0 70%); }\n  .cat-active { clip-path: polygon(0 0, 92% 0, 100% 50%, 92% 100%, 0 100%); }\n  .ticket-top { clip-path: polygon(0% 10px,4% 0,8% 10px,12% 0,16% 10px,20% 0,24% 10px,28% 0,32% 10px,36% 0,40% 10px,44% 0,48% 10px,52% 0,56% 10px,60% 0,64% 10px,68% 0,72% 10px,76% 0,80% 10px,84% 0,88% 10px,92% 0,96% 10px,100% 0,100% 100%,0 100%); }\n  .num-tabular { font-variant-numeric: tabular-nums; }\n</style>\n<div class=\"font-cond bg-[#F4F0E5] text-[#141414] min-h-screen\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Barlow Condensed',sans-serif;\">\n    <!-- ================= NIVEL 1: UTILIDAD ================= -->\n    <header class=\"relative bg-white border-b-2 border-[#141414]\" data-kid=\"1-1\" data-name=\"main header section\">\n        <div class=\"max-w-[1560px] mx-auto h-[68px] flex items-center gap-6 px-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <!-- Logo -->\n            <div class=\"flex items-center gap-2 shrink-0\" data-kid=\"1-1-1-1\" data-name=\"logo container\">\n                <div class=\"w-10 h-10 bg-[#D93627] flex items-center justify-center\" data-kid=\"1-1-1-1-1\" data-name=\"logo icon background\">\n                    <span class=\"font-osw font-bold text-white text-lg\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo icon text\">\n                        BE\n                    </span>\n                </div>\n                <span class=\"font-osw font-bold text-[22px] tracking-tight leading-none\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    BAZAR EXPRESS\n                </span>\n            </div>\n            <!-- Search -->\n            <div class=\"flex-1 max-w-[560px] hidden md:flex\" data-kid=\"1-1-1-2\" data-name=\"search component\">\n                <div class=\"flex items-center w-full border-2 border-[#141414] h-11\" data-kid=\"1-1-1-2-1\" data-name=\"search field container\">\n                    <input class=\"flex-1 h-full px-4 text-[15px] outline-none bg-transparent placeholder:text-[#625F58]\" data-kid=\"1-1-1-2-1-1\" data-name=\"search input field\" placeholder=\"Buscar productos...\" type=\"text\"/>\n                    <button aria-label=\"Buscar\" class=\"w-11 h-full bg-[#141414] text-white flex items-center justify-center shrink-0\" data-kid=\"1-1-1-2-1-2\" data-name=\"search button\">\n                        <i class=\"ti ti-search text-[18px]\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"search icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex-1 md:hidden\" data-kid=\"1-1-1-3\" data-name=\"spacer element\">\n            </div>\n            <!-- Mobile menu -->\n            <button aria-label=\"Categorías\" class=\"md:hidden w-10 h-10 flex items-center justify-center border-2 border-[#141414]\" data-kid=\"1-1-1-4\" data-name=\"mobile menu button\">\n                <i class=\"ti ti-menu-2 text-[20px]\" data-kid=\"1-1-1-4-1\" data-name=\"menu hamburger icon\">\n                </i>\n            </button>\n            <!-- Cart -->\n            <div class=\"relative shrink-0\" data-kid=\"1-1-1-5\" data-name=\"cart dropdown container\">\n                <button class=\"flex items-center gap-2 bg-[#FFD237] border-2 border-[#141414] h-11 px-3\" data-kid=\"1-1-1-5-1\" data-name=\"open cart button\">\n                    <i class=\"ti ti-shopping-cart text-[20px]\" data-kid=\"1-1-1-5-1-1\" data-name=\"shopping cart icon\">\n                    </i>\n                    <span class=\"font-osw font-bold text-[15px] hidden sm:inline\" data-kid=\"1-1-1-5-1-2\" data-name=\"cart button label\">\n                        Carrito\n                    </span>\n                    <span class=\"w-6 h-6 bg-[#141414] text-white text-[13px] font-bold flex items-center justify-center num-tabular\" data-kid=\"1-1-1-5-1-3\" data-name=\"cart items counter\">\n                        3\n                    </span>\n                </button>\n                <!-- TICKET CART PREVIEW (static demo) -->\n                <div class=\"absolute right-0 top-[56px] w-[300px] bg-white border-2 border-[#141414] shadow-[4px_4px_0_#141414] z-30\" data-kid=\"1-1-1-5-2\" data-name=\"cart preview menu\">\n                    <div class=\"ticket-top h-3 bg-white\" data-kid=\"1-1-1-5-2-1\" data-name=\"cart ticket header shape\">\n                    </div>\n                    <div class=\"px-4 pt-1 pb-3\" data-kid=\"1-1-1-5-2-2\" data-name=\"cart preview items wrapper\">\n                        <p class=\"font-osw font-bold text-[13px] tracking-wide uppercase mb-2\" data-kid=\"1-1-1-5-2-2-1\" data-name=\"cart preview title\">\n                            Tu carrito\n                        </p>\n                        <div class=\"flex items-center justify-between py-2 border-b border-dashed border-[#CFC9BA]\" data-kid=\"1-1-1-5-2-2-2\" data-name=\"cart item row 1\">\n                            <div class=\"flex items-center gap-2 min-w-0\" data-kid=\"1-1-1-5-2-2-2-1\" data-name=\"cart item info wrapper\">\n                                <img alt=\"Cafetera Retro Premium - foto de Antonio Buljubasich en Pexels\" class=\"w-9 h-9 object-cover border border-[#CFC9BA] shrink-0\" data-kid=\"1-1-1-5-2-2-2-1-1\" data-name=\"cart item image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/38862129/pexels-photo-38862129.jpeg?auto=compress&cs=tinysrgb&w=80&q=80\"/>\n                                <span class=\"text-[13px] truncate\" data-kid=\"1-1-1-5-2-2-2-1-2\" data-name=\"cart item name\">\n                                    Cafetera Retro x1\n                                </span>\n                            </div>\n                            <span class=\"font-osw font-bold text-[13px] num-tabular shrink-0\" data-kid=\"1-1-1-5-2-2-2-2\" data-name=\"cart item price\">\n                                $54.999\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between py-2 border-b border-dashed border-[#CFC9BA]\" data-kid=\"1-1-1-5-2-2-3\" data-name=\"cart item row 2\">\n                            <div class=\"flex items-center gap-2 min-w-0\" data-kid=\"1-1-1-5-2-2-3-1\" data-name=\"cart item info wrapper 2\">\n                                <img alt=\"Auriculares Inalámbricos - foto de Caleb Oquendo en Pexels\" class=\"w-9 h-9 object-cover border border-[#CFC9BA] shrink-0\" data-kid=\"1-1-1-5-2-2-3-1-1\" data-name=\"cart item image 2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7772548/pexels-photo-7772548.jpeg?auto=compress&cs=tinysrgb&w=80&q=80\"/>\n                                <span class=\"text-[13px] truncate\" data-kid=\"1-1-1-5-2-2-3-1-2\" data-name=\"cart item name 2\">\n                                    Auriculares x1\n                                </span>\n                            </div>\n                            <span class=\"font-osw font-bold text-[13px] num-tabular shrink-0\" data-kid=\"1-1-1-5-2-2-3-2\" data-name=\"cart item price 2\">\n                                $32.499\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between py-2\" data-kid=\"1-1-1-5-2-2-4\" data-name=\"cart item row 3\">\n                            <div class=\"flex items-center gap-2 min-w-0\" data-kid=\"1-1-1-5-2-2-4-1\" data-name=\"cart item info wrapper 3\">\n                                <img alt=\"Kit de Limpieza del Hogar - foto de Anna Shvets en Pexels\" class=\"w-9 h-9 object-cover border border-[#CFC9BA] shrink-0\" data-kid=\"1-1-1-5-2-2-4-1-1\" data-name=\"cart item image 3\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5217899/pexels-photo-5217899.jpeg?auto=compress&cs=tinysrgb&w=80&q=80\"/>\n                                <span class=\"text-[13px] truncate\" data-kid=\"1-1-1-5-2-2-4-1-2\" data-name=\"cart item name 3\">\n                                    Kit Limpieza x1\n                                </span>\n                            </div>\n                            <span class=\"font-osw font-bold text-[13px] num-tabular shrink-0\" data-kid=\"1-1-1-5-2-2-4-2\" data-name=\"cart item price 3\">\n                                $18.299\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between mt-2 pt-2 border-t-2 border-[#141414]\" data-kid=\"1-1-1-5-2-2-5\" data-name=\"cart subtotal row\">\n                            <span class=\"font-osw font-bold text-[14px] uppercase\" data-kid=\"1-1-1-5-2-2-5-1\" data-name=\"subtotal label\">\n                                Subtotal\n                            </span>\n                            <span class=\"font-osw font-bold text-[16px] num-tabular\" data-kid=\"1-1-1-5-2-2-5-2\" data-name=\"subtotal amount\">\n                                $105.797\n                            </span>\n                        </div>\n                        <button class=\"w-full mt-3 h-10 bg-[#141414] text-white font-osw font-bold text-[13px] uppercase tracking-wide\" data-kid=\"1-1-1-5-2-2-6\" data-name=\"checkout button\">\n                            Ver carrito\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- ================= NIVEL 2: CATEGORÍAS ================= -->\n        <nav class=\"bg-[#173BBE] h-[46px] flex items-center overflow-x-auto\" data-kid=\"1-1-2\" data-name=\"navigation menu\">\n            <div class=\"max-w-[1560px] mx-auto w-full flex items-stretch px-6 gap-1\" data-kid=\"1-1-2-1\" data-name=\"navigation link wrapper\">\n                <a class=\"flex items-center px-4 h-[46px] bg-[#FFD237] text-[#141414] font-osw font-bold text-[13px] uppercase tracking-wide shrink-0 cat-active\" data-kid=\"1-1-2-1-1\" data-name=\"active category link\" href=\"#\">\n                    Todos\n                </a>\n                <a class=\"flex items-center px-4 h-[46px] text-white font-osw font-medium text-[13px] uppercase tracking-wide shrink-0 hover:bg-white/10\" data-kid=\"1-1-2-1-2\" data-name=\"category link 1\" href=\"#\">\n                    Electrodomésticos\n                </a>\n                <a class=\"flex items-center px-4 h-[46px] text-white font-osw font-medium text-[13px] uppercase tracking-wide shrink-0 hover:bg-white/10\" data-kid=\"1-1-2-1-3\" data-name=\"category link 2\" href=\"#\">\n                    Cocina\n                </a>\n                <a class=\"flex items-center px-4 h-[46px] text-white font-osw font-medium text-[13px] uppercase tracking-wide shrink-0 hover:bg-white/10\" data-kid=\"1-1-2-1-4\" data-name=\"category link 3\" href=\"#\">\n                    Tecnología\n                </a>\n                <a class=\"flex items-center px-4 h-[46px] text-white font-osw font-medium text-[13px] uppercase tracking-wide shrink-0 hover:bg-white/10\" data-kid=\"1-1-2-1-5\" data-name=\"category link 4\" href=\"#\">\n                    Herramientas\n                </a>\n                <a class=\"flex items-center px-4 h-[46px] text-white font-osw font-medium text-[13px] uppercase tracking-wide shrink-0 hover:bg-white/10\" data-kid=\"1-1-2-1-6\" data-name=\"category link 5\" href=\"#\">\n                    Limpieza\n                </a>\n                <a class=\"flex items-center px-4 h-[46px] bg-[#D93627] text-white font-osw font-bold text-[13px] uppercase tracking-wide shrink-0\" data-kid=\"1-1-2-1-7\" data-name=\"category link 6\" href=\"#\">\n                    Ofertas\n                </a>\n                <a class=\"flex items-center px-4 h-[46px] text-white/80 font-osw font-medium text-[13px] uppercase tracking-wide shrink-0 hover:bg-white/10 ml-auto\" data-kid=\"1-1-2-1-8\" data-name=\"more categories link\" href=\"#\">\n                    Más categorías\n                    <i class=\"ti ti-chevron-right text-[14px] ml-1\" data-kid=\"1-1-2-1-8-1\" data-name=\"chevron icon\">\n                    </i>\n                </a>\n            </div>\n        </nav>\n    </header>\n    <!-- ================= HERO CAMPAÑA ================= -->\n    <section class=\"w-full h-[340px] flex overflow-hidden border-b-4 border-[#141414]\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"w-[42%] bg-[#D93627] relative flex flex-col justify-center px-10 py-8 overflow-hidden\" data-kid=\"1-2-1\" data-name=\"hero content column\">\n            <div class=\"absolute inset-0 opacity-[0.08]\" data-kid=\"1-2-1-1\" data-name=\"hero background pattern\" style=\"background-image: radial-gradient(circle, #fff 2px, transparent 2px); background-size: 22px 22px;\">\n            </div>\n            <span class=\"relative font-osw font-bold text-white text-[13px] uppercase tracking-[3px] mb-3\" data-kid=\"1-2-1-2\" data-name=\"hero eyebrow label\">\n                Bazar Express\n            </span>\n            <h1 class=\"relative font-osw font-bold text-white text-[46px] leading-[1.05] mb-3\" data-kid=\"1-2-1-3\" data-name=\"hero headline\" style=\"font-family:'Oswald',sans-serif;\">\n                Liquidación\n                <br data-kid=\"1-2-1-3-1\" data-name=\"headline line break\"/>\n                de Invierno\n            </h1>\n            <p class=\"relative text-white/90 text-[16px] leading-snug mb-5 max-w-[360px]\" data-kid=\"1-2-1-4\" data-name=\"hero description text\">\n                Hasta 30% OFF en electrodomésticos, tecnología y herramientas para tu hogar. Stock limitado.\n            </p>\n            <a class=\"relative inline-flex items-center gap-2 bg-[#FFD237] text-[#141414] font-osw font-bold text-[14px] uppercase tracking-wide px-6 h-12 w-fit\" data-kid=\"1-2-1-5\" data-name=\"hero call-to-action button\" href=\"#catalogo\">\n                Ver productos\n                <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-2-1-5-1\" data-name=\"arrow icon\">\n                </i>\n            </a>\n        </div>\n        <div class=\"w-[6%] bg-[#141414]\" data-kid=\"1-2-2\" data-name=\"hero decorative shape\" style=\"clip-path: polygon(100% 0, 100% 100%, 0 100%);\">\n        </div>\n        <div class=\"w-[52%] relative\" data-kid=\"1-2-3\" data-name=\"hero image container\">\n            <img alt=\"Góndola de productos variados para el hogar - foto de Joaquin Reyes Ramos en Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-2-3-1\" data-name=\"hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/38575493/pexels-photo-38575493.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n        </div>\n    </section>\n    <!-- ================= FRANJA DE PROMOCIONES ================= -->\n    <section class=\"bg-[#D93627] h-14 overflow-hidden flex items-center border-b-2 border-[#141414]\" data-kid=\"1-3\" data-name=\"marquee promotions section\">\n        <div class=\"marquee-track\" data-kid=\"1-3-1\" data-name=\"marquee track\">\n            <div class=\"flex items-center shrink-0\" data-kid=\"1-3-1-1\" data-name=\"marquee content set 1\">\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-1-1\" data-name=\"promo item 1 text\">\n                    🚚 ENVÍOS A TODO EL PAÍS\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-1-2\" data-name=\"promo separator 1\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-1-3\" data-name=\"promo item 2 text\">\n                    💳 HASTA 6 CUOTAS SIN INTERÉS\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-1-4\" data-name=\"promo separator 2\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-1-5\" data-name=\"promo item 3 text\">\n                    🔒 COMPRA 100% SEGURA\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-1-6\" data-name=\"promo separator 3\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-1-7\" data-name=\"promo item 4 text\">\n                    ✨ NUEVOS INGRESOS TODAS LAS SEMANAS\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-1-8\" data-name=\"promo separator 4\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-1-9\" data-name=\"promo item 5 text\">\n                    🎁 PROMOCIONES EXCLUSIVAS\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-1-10\" data-name=\"promo separator 5\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-1-11\" data-name=\"promo item 6 text\">\n                    ⭐ CALIDAD PREMIUM\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-1-12\" data-name=\"promo separator 6\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-1-13\" data-name=\"promo item 7 text\">\n                    ⚡ ENTREGA RÁPIDA\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-1-14\" data-name=\"promo separator 7\">\n                </span>\n            </div>\n            <div class=\"flex items-center shrink-0\" data-kid=\"1-3-1-2\" data-name=\"marquee content set 2\">\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-2-1\" data-name=\"promo item 1 text 2\">\n                    🚚 ENVÍOS A TODO EL PAÍS\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-2-2\" data-name=\"promo separator 1 2\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\" data-kid=\"1-3-1-2-3\" data-name=\"promo item 2 text 2\">\n                    💳 HASTA 6 CUOTAS SIN INTERÉS\n                </span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[#FFD237] shrink-0\" data-kid=\"1-3-1-2-4\" data-name=\"promo separator 2 2\">\n                </span>\n                <span class=\"flex items-center h-14 px-6 text-white font-osw font-bold text-[14px] uppercase tracking-wide\