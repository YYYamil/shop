      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap');\n  .font-serif-display { font-family: 'Playfair Display', serif; }\n  .font-sans { font-family: 'Inter', sans-serif; }\n  .marquee-track { animation: marqueeScroll 22s linear infinite; }\n  @keyframes marqueeScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n  .img-zoom { transition: transform 1.2s cubic-bezier(0.16,1,0.3,1); }\n  .card:hover .img-zoom { transform: scale(1.06); }\n  .underline-hover { position: relative; }\n  .underline-hover::after { content:''; position:absolute; left:0; bottom:-4px; width:100%; height:1px; background:#111111; transform: scaleX(0); transform-origin: left; transition: transform .35s cubic-bezier(0.16,1,0.3,1); }\n  .underline-hover:hover::after { transform: scaleX(1); }\n  .cat-overlay { transition: background-color .4s ease; }\n  .cat-card:hover .cat-overlay { background-color: rgba(17,17,17,0.45); }\n  .cat-card:hover .cat-label { transform: translateY(-2px); }\n  .cat-label { transition: transform .4s cubic-bezier(0.16,1,0.3,1); }\n  .fab-jiggle:hover { animation: jiggle .5s ease; }\n  @keyframes jiggle { 0%,100%{transform:rotate(0)} 25%{transform:rotate(-8deg)} 50%{transform:rotate(8deg)} 75%{transform:rotate(-4deg)} }\n  .add-reveal { opacity:0; transform: translateY(6px); transition: opacity .3s ease, transform .3s ease; }\n  .card:hover .add-reveal { opacity:1; transform: translateY(0); }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-sans bg-[#FAFAFA] text-[#111111]\" data-kid=\"2\" data-name=\"page layout container\">\n    <!-- NAVBAR -->\n    <header class=\"absolute top-0 left-0 w-full z-30\" data-kid=\"2-1\" data-name=\"main navigation bar\">\n        <div class=\"max-w-[1440px] mx-auto flex items-center justify-between px-8 md:px-14 py-6\" data-kid=\"2-1-1\" data-name=\"navigation container\">\n            <div class=\"font-serif-display text-white text-2xl tracking-tight\" data-kid=\"2-1-1-1\" data-name=\"studio brand logo\">\n                Vibra Studio\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"2-1-1-2\" data-name=\"navigation action items\">\n                <button aria-label=\"Buscar\" class=\"text-white\" data-kid=\"2-1-1-2-1\" data-name=\"search button\">\n                    <i class=\"ti ti-search text-[20px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"search icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Carrito\" class=\"relative text-white flex items-center gap-1\" data-kid=\"2-1-1-2-2\" data-name=\"shopping cart button\">\n                    <i class=\"ti ti-shopping-bag text-[20px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"shopping bag icon\">\n                    </i>\n                    <span class=\"absolute -top-2 -right-3 bg-[#CBA135] text-[#111111] text-[10px] font-semibold w-4 h-4 rounded-full flex items-center justify-center\" data-kid=\"2-1-1-2-2-2\" data-name=\"shopping cart counter badge\">\n                        3\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <!-- HERO -->\n    <section class=\"relative w-full h-[90vh] min-h-[640px] overflow-hidden\" data-kid=\"2-2\" data-name=\"hero section\">\n        <img alt=\"Modelo con blazer elegante, fotografía de Chyntia Juls en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-2-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1613915617430-8ab0fd7c6baf?auto=format&w=1800&q=80&fit=crop\"/>\n        <div class=\"absolute inset-0\" data-kid=\"2-2-2\" data-name=\"hero gradient overlay\" style=\"background: linear-gradient(to top, rgba(17,17,17,0.85), rgba(17,17,17,0.05) 55%);\">\n        </div>\n        <div class=\"absolute bottom-14 left-8 md:left-14 max-w-xl\" data-kid=\"2-2-3\" data-name=\"hero content container\">\n            <p class=\"text-white/70 text-xs tracking-[0.25em] uppercase font-sans mb-4\" data-kid=\"2-2-3-1\" data-name=\"hero collection label\">\n                Colección Primavera 26\n            </p>\n            <h1 class=\"font-serif-display text-white text-[13vw] md:text-[6.2vw] leading-[0.95] tracking-tight mb-6\" data-kid=\"2-2-3-2\" data-name=\"hero headline text\">\n                Descubrí\n                <br data-kid=\"2-2-3-2-1\" data-name=\"line break\"/>\n                tu estilo\n            </h1>\n            <p class=\"text-white/85 font-sans text-base md:text-lg max-w-md mb-8 leading-relaxed\" data-kid=\"2-2-3-3\" data-name=\"hero description text\">\n                Piezas seleccionadas con materiales nobles y confección cuidada, pensadas para durar más de una temporada.\n            </p>\n            <a class=\"underline-hover inline-flex items-center gap-2 text-white font-sans text-sm tracking-wide uppercase\" data-kid=\"2-2-3-4\" data-name=\"hero call-to-action link\" href=\"#productos\">\n                Descubrir colección\n                <i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"2-2-3-4-1\" data-name=\"right arrow icon\">\n                </i>\n            </a>\n        </div>\n    </section>\n    <!-- MARQUEE -->\n    <section class=\"w-full h-12 bg-[#111111] overflow-hidden flex items-center\" data-kid=\"2-3\" data-name=\"marquee section\">\n        <div class=\"marquee-track flex whitespace-nowrap gap-10 text-white/80 text-xs tracking-[0.2em] uppercase font-sans\" data-kid=\"2-3-1\" data-name=\"marquee scrolling track\">\n            <span class=\"flex gap-10\" data-kid=\"2-3-1-1\" data-name=\"marquee content set one\">\n                <span data-kid=\"2-3-1-1-1\" data-name=\"shipping info text\">\n                    Envíos a todo el país\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-1-2\" data-name=\"separator bullet\">\n                    ·\n                </span>\n                <span data-kid=\"2-3-1-1-3\" data-name=\"installment info text\">\n                    3 y 6 cuotas sin interés\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-1-4\" data-name=\"separator bullet\">\n                    ·\n                </span>\n                <span data-kid=\"2-3-1-1-5\" data-name=\"return policy info text\">\n                    Cambios sin cargo dentro de los 30 días\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-1-6\" data-name=\"separator bullet\">\n                    ·\n                </span>\n                <span data-kid=\"2-3-1-1-7\" data-name=\"updates info text\">\n                    Nuevos ingresos cada semana\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-1-8\" data-name=\"separator bullet\">\n                    ·\n                </span>\n            </span>\n            <span class=\"flex gap-10\" data-kid=\"2-3-1-2\" data-name=\"marquee content set two\">\n                <span data-kid=\"2-3-1-2-1\" data-name=\"shipping info text\">\n                    Envíos a todo el país\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-2-2\" data-name=\"separator bullet\">\n                    ·\n                </span>\n                <span data-kid=\"2-3-1-2-3\" data-name=\"installment info text\">\n                    3 y 6 cuotas sin interés\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-2-4\" data-name=\"separator bullet\">\n                    ·\n                </span>\n                <span data-kid=\"2-3-1-2-5\" data-name=\"return policy info text\">\n                    Cambios sin cargo dentro de los 30 días\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-2-6\" data-name=\"separator bullet\">\n                    ·\n                </span>\n                <span data-kid=\"2-3-1-2-7\" data-name=\"updates info text\">\n                    Nuevos ingresos cada semana\n                </span>\n                <span class=\"text-[#CBA135]\" data-kid=\"2-3-1-2-8\" data-name=\"separator bullet\">\n                    ·\n                </span>\n            </span>\n        </div>\n    </section>\n    <!-- CATEGORIAS -->\n    <section class=\"max-w-[1440px] mx-auto px-8 md:px-14 py-24\" data-kid=\"2-4\" data-name=\"categories section\">\n        <div class=\"flex items-end justify-between mb-10\" data-kid=\"2-4-1\" data-name=\"categories header container\">\n            <h2 class=\"font-serif-display text-3xl md:text-4xl\" data-kid=\"2-4-1-1\" data-name=\"categories section title\">\n                Categorías\n            </h2>\n            <a class=\"underline-hover text-sm uppercase tracking-wide text-[#111111]/70\" data-kid=\"2-4-1-2\" data-name=\"view all link\" href=\"#productos\">\n                Ver todo\n            </a>\n        </div>\n        <div class=\"grid grid-cols-1 md:grid-cols-4 gap-[2px]\" data-kid=\"2-4-2\" data-name=\"categories grid container\" style=\"grid-template-rows: repeat(2, 260px);\">\n            <a class=\"cat-card relative overflow-hidden md:col-span-1\" data-kid=\"2-4-2-1\" data-name=\"tailoring category card\" href=\"#\" style=\"grid-row: span 2;\">\n                <img alt=\"Blazers y sastrería, fotografía de Anni Peng en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"2-4-2-1-1\" data-name=\"category image\" src=\"https://images.unsplash.com/photo-1629511565591-a1d494ad6c58?auto=format&w=700&q=80&fit=crop\"/>\n                <div class=\"cat-overlay absolute inset-0 bg-[#111111]/25\" data-kid=\"2-4-2-1-2\" data-name=\"category hover overlay\">\n                </div>\n                <span class=\"cat-label absolute inset-0 flex items-center justify-center font-serif-display italic text-white text-2xl\" data-kid=\"2-4-2-1-3\" data-name=\"category label\">\n                    Sastrería\n                </span>\n            </a>\n            <a class=\"cat-card relative overflow-hidden md:col-span-2\" data-kid=\"2-4-2-2\" data-name=\"dresses category card\" href=\"#\">\n                <img alt=\"Moda elegante, fotografía de Milbert Sambile en Pexels\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"2-4-2-2-1\" data-name=\"category image\" src=\"https://images.pexels.com/photos/27438332/pexels-photo-27438332.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n                <div class=\"cat-overlay absolute inset-0 bg-[#111111]/25\" data-kid=\"2-4-2-2-2\" data-name=\"category hover overlay\">\n                </div>\n                <span class=\"cat-label absolute inset-0 flex items-center justify-center font-serif-display italic text-white text-2xl\" data-kid=\"2-4-2-2-3\" data-name=\"category label\">\n                    Vestidos\n                </span>\n            </a>\n            <a class=\"cat-card relative overflow-hidden md:col-span-1\" data-kid=\"2-4-2-3\" data-name=\"accessories category card\" href=\"#\">\n                <img alt=\"Luz suave sobre textiles, fotografía de Sueda Dilli en Pexels\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"2-4-2-3-1\" data-name=\"category image\" src=\"https://images.pexels.com/photos/18104900/pexels-photo-18104900.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                <div class=\"cat-overlay absolute inset-0 bg-[#111111]/25\" data-kid=\"2-4-2-3-2\" data-name=\"category hover overlay\">\n                </div>\n                <span class=\"cat-label absolute inset-0 flex items-center justify-center font-serif-display italic text-white text-xl\" data-kid=\"2-4-2-3-3\" data-name=\"category label\">\n                    Accesorios\n                </span>\n            </a>\n            <a class=\"cat-card relative overflow-hidden md:col-span-1\" data-kid=\"2-4-2-4\" data-name=\"footwear category card\" href=\"#\">\n                <img alt=\"Sombra artística sobre prenda, fotografía de Yusra Mizgin Günay en Pexels\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"2-4-2-4-1\" data-name=\"category image\" src=\"https://images.pexels.com/photos/16377181/pexels-photo-16377181.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                <div class=\"cat-overlay absolute inset-0 bg-[#111111]/25\" data-kid=\"2-4-2-4-2\" data-name=\"category hover overlay\">\n                </div>\n                <span class=\"cat-label absolute inset-0 flex items-center justify-center font-serif-display italic text-white text-xl\" data-kid=\"2-4-2-4-3\" data-name=\"category label\">\n                    Calzado\n                </span>\n            </a>\n            <a class=\"cat-card relative overflow-hidden md:col-span-1\" data-kid=\"2-4-2-5\" data-name=\"home category card\" href=\"#\">\n                <img alt=\"Luz cálida, fotografía de Hassan Bouamoud en Pexels\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"2-4-2-5-1\" data-name=\"category image\" src=\"https://images.pexels.com/photos/30923846/pexels-photo-30923846.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                <div class=\"cat-overlay absolute inset-0 bg-[#111111]/25\" data-kid=\"2-4-2-5-2\" data-name=\"category hover overlay\">\n                </div>\n                <span class=\"cat-label absolute inset-0 flex items-center justify-center font-serif-display italic text-white text-xl\" data-kid=\"2-4-2-5-3\" data-name=\"category label\">\n                    Hogar\n                </span>\n            </a>\n        </div>\n    </section>\n    <!-- PRODUCTOS -->\n    <section class=\"max-w-[1440px] mx-auto px-8 md:px-14 pb-24\" data-kid=\"2-5\" data-name=\"products section\" id=\"productos\">\n        <div class=\"flex items-end justify-between mb-10\" data-kid=\"2-5-1\" data-name=\"products section header\">\n            <h2 class=\"font-serif-display text-3xl md:text-4xl\" data-kid=\"2-5-1-1\" data-name=\"products section title\">\n                Todos los productos\n            </h2>\n            <span class=\"text-sm text-[#111111]/50 tracking-wide\" data-kid=\"2-5-1-2\" data-name=\"product count text\">\n                12 productos\n            </span>\n        </div>\n        <div class=\"grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-14\" data-kid=\"2-5-2\" data-name=\"products grid container\">\n            <article class=\"card group\" data-kid=\"2-5-2-1\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-1-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Vestido midi, fotografía de Lauro Rodríguez en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-1-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1664076458686-3449062080ac?auto=format&w=700&q=80&fit=crop\"/>\n                    <span class=\"absolute top-3 left-3 border border-white/70 text-white text-[10px] tracking-[0.15em] uppercase px-2 py-1\" data-kid=\"2-5-2-1-1-2\" data-name=\"product badge\">\n                        Destacado\n                    </span>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-1-1-3\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-1-1-3-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-1-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-1-2-1\" data-name=\"product name\">\n                        Vestido midi Alba\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-1-2-2\" data-name=\"product price\">\n                        $78.500\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group md:mt-12\" data-kid=\"2-5-2-2\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-2-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Blazer estructurado, fotografía de Yusra Mizgin Günay en Pexels\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-2-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/16377181/pexels-photo-16377181.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                    <span class=\"absolute top-3 left-3 border border-[#CBA135] text-[#CBA135] text-[10px] tracking-[0.15em] uppercase px-2 py-1\" data-kid=\"2-5-2-2-1-2\" data-name=\"product discount badge\">\n                        -20%\n                    </span>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-2-1-3\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-2-1-3-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-2-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-2-2-1\" data-name=\"product name\">\n                        Blazer Onyx estructurado\n                    </h3>\n                    <p class=\"text-sm mt-1\" data-kid=\"2-5-2-2-2-2\" data-name=\"price container\">\n                        <span class=\"text-[#111111]/40 line-through mr-2\" data-kid=\"2-5-2-2-2-2-1\" data-name=\"original price text\">\n                            $96.000\n                        </span>\n                        <span class=\"text-[#111111]\" data-kid=\"2-5-2-2-2-2-2\" data-name=\"discounted price text\">\n                            $76.800\n                        </span>\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group\" data-kid=\"2-5-2-3\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-3-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Camisa lino, fotografía de Anni Peng en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-3-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1629511565591-a1d494ad6c58?auto=format&w=700&q=80&fit=crop\"/>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-3-1-2\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-3-1-2-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-3-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-3-2-1\" data-name=\"product name\">\n                        Camisa lino Marea\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-3-2-2\" data-name=\"product price\">\n                        $54.900\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group\" data-kid=\"2-5-2-4\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-4-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Conjunto elegante, fotografía de Milbert Sambile en Pexels\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-4-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/27438332/pexels-photo-27438332.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-4-1-2\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-4-1-2-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-4-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-4-2-1\" data-name=\"product name\">\n                        Conjunto Aurora dos piezas\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-4-2-2\" data-name=\"product price\">\n                        $112.300\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group md:mt-12\" data-kid=\"2-5-2-5\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden bg-[#efece4]\" data-kid=\"2-5-2-5-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Accesorio de cuero, fotografía de gryffyn m en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover img-zoom opacity-60\" data-kid=\"2-5-2-5-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1602911310167-1b82343f6264?auto=format&w=700&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-[#111111]/50 flex items-center justify-center\" data-kid=\"2-5-2-5-1-2\" data-name=\"out of stock overlay\">\n                        <span class=\"text-white text-xs tracking-[0.2em] uppercase border border-white/60 px-3 py-1\" data-kid=\"2-5-2-5-1-2-1\" data-name=\"out of stock label\">\n                            Sin stock\n                        </span>\n                    </div>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-5-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-5-2-1\" data-name=\"product name\">\n                        Cinturón cuero Nogal\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-5-2-2\" data-name=\"product price\">\n                        $38.400\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group\" data-kid=\"2-5-2-6\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-6-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Abrigo largo, fotografía de Chyntia Juls en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-6-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1613915617430-8ab0fd7c6baf?auto=format&w=700&q=80&fit=crop\"/>\n                    <span class=\"absolute top-3 left-3 border border-white/70 text-white text-[10px] tracking-[0.15em] uppercase px-2 py-1\" data-kid=\"2-5-2-6-1-2\" data-name=\"product badge\">\n                        Destacado\n                    </span>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-6-1-3\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-6-1-3-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-6-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-6-2-1\" data-name=\"product name\">\n                        Abrigo Invierno Praga\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-6-2-2\" data-name=\"product price\">\n                        $145.000\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group\" data-kid=\"2-5-2-7\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-7-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Ambiente cálido de interior, fotografía de Muhammad Zahran en Pexels\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-7-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/2872020/pexels-photo-2872020.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-7-1-2\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-7-1-2-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-7-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-7-2-1\" data-name=\"product name\">\n                        Pantalón sastrero Rio\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-7-2-2\" data-name=\"product price\">\n                        $62.700\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group md:mt-12\" data-kid=\"2-5-2-8\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-8-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Textura cálida, fotografía de Hassan Bouamoud en Pexels\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-8-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/30923846/pexels-photo-30923846.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                    <span class=\"absolute top-3 left-3 border border-[#CBA135] text-[#CBA135] text-[10px] tracking-[0.15em] uppercase px-2 py-1\" data-kid=\"2-5-2-8-1-2\" data-name=\"product discount badge\">\n                        -15%\n                    </span>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-8-1-3\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-8-1-3-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-8-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-8-2-1\" data-name=\"product name\">\n                        Suéter merino Bruma\n                    </h3>\n                    <p class=\"text-sm mt-1\" data-kid=\"2-5-2-8-2-2\" data-name=\"price container\">\n                        <span class=\"text-[#111111]/40 line-through mr-2\" data-kid=\"2-5-2-8-2-2-1\" data-name=\"original price text\">\n                            $58.000\n                        </span>\n                        <span class=\"text-[#111111]\" data-kid=\"2-5-2-8-2-2-2\" data-name=\"discounted price text\">\n                            $49.300\n                        </span>\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group\" data-kid=\"2-5-2-9\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-9-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Falda plisada, fotografía de Lauro Rodríguez en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-9-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1664076458686-3449062080ac?auto=format&w=700&q=80&fit=crop\"/>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-9-1-2\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-9-1-2-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-9-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-9-2-1\" data-name=\"product name\">\n                        Falda plisada Nube\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-9-2-2\" data-name=\"product price\">\n                        $45.200\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group\" data-kid=\"2-5-2-10\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-10-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Textiles delicados, fotografía de Sueda Dilli en Pexels\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-10-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18104900/pexels-photo-18104900.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-10-1-2\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-10-1-2-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-10-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-10-2-1\" data-name=\"product name\">\n                        Pañuelo seda Ribera\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-10-2-2\" data-name=\"product price\">\n                        $29.900\n                    </p>\n                </div>\n            </article>\n            <article class=\"card group md:mt-12\" data-kid=\"2-5-2-11\" data-name=\"product card\">\n                <div class=\"relative overflow-hidden\" data-kid=\"2-5-2-11-1\" data-name=\"product image wrapper\" style=\"aspect-ratio:4/5;\">\n                    <img alt=\"Prenda con textura, fotografía de Yusra Mizgin Günay en Pexels\" class=\"absolute inset-0 w-full h-full object-cover img-zoom\" data-kid=\"2-5-2-11-1-1\" data-name=\"product image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/16377181/pexels-photo-16377181.jpeg?auto=compress&cs=tinysrgb&w=700&q=80\"/>\n                    <button class=\"add-reveal absolute bottom-3 right-3 bg-[#111111] text-white w-9 h-9 flex items-center justify-center\" data-kid=\"2-5-2-11-1-2\" data-name=\"add to cart button\">\n                        <i class=\"ti ti-plus text-[16px]\" data-kid=\"2-5-2-11-1-2-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"pt-4\" data-kid=\"2-5-2-11-2\" data-name=\"product info container\">\n                    <h3 class=\"text-sm font-medium\" data-kid=\"2-5-2-11-2-1\" data-name=\"product name\">\n                        Vestido lencero Sol\n                    </h3>\n                    <p class=\"text-sm text-[#111111]/50 mt-1\" data-kid=\"2-5-2-11-2-2\" data-name=\"product price\">\n                        $67.800\n                    </p>\n                </div>\n            </article>\n        </div>\n    </section>\n    <!-- QUICK VIEW STATIC EXAMPLE -->\n    <section class=\"max-w-[1440px] mx-auto px-8 md:px-14 pb-24\" data-kid=\"2-6\" data-name=\"quick view modal section\">\n        <p class=\"text-xs uppercase tracking-[0.2em] text-[#111111]/40 mb-4\" data-kid=\"2-6-1\" data-name=\"section instruction label\">\n            Vista rápida — ejemplo de estado del modal\n        </p>\n        <div class=\"grid md:grid-cols-2 border border-[#111111]/10\" data-kid=\"2-6-2\" data-name=\"modal grid container\">\n            <div class=\"relative min-h-[420px]\" data-kid=\"2-6-2-1\" data-name=\"modal image container\">\n                <img alt=\"Abrigo Invierno Praga, fotografía de Chyntia Juls en Unsplash\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"2-6-2-1-1\" data-name=\"modal product image\" src=\"https://images.unsplash.com/photo-1613915617430-8ab0fd7c6baf?auto=format&w=1000&q=80&fit=crop\"/>\n            </div>\n            <div class=\"bg-white p-10 md:p-14 flex flex-col justify-center\" data-kid=\"2-6-2-2\" data-name=\"modal product info container\">\n                <h3 class=\"font-serif-display text-3xl mb-3\" data-kid=\"2-6-2-2-1\" data-name=\"modal product title\">\n                    Abrigo Invierno Praga\n                </h3>\n                <p class=\"text-[#CBA135] text-xl mb-4\" data-kid=\"2-6-2-2-2\" data-name=\"modal product price\">\n                    $145.000\n                </p>\n                <p class=\"text-sm text-[#111111]/50 mb-2\" data-kid=\"2-6-2-2-3\" data-name=\"stock status label\">\n                    Stock disponible\n                </p>\n                <p class=\"text-sm text-[#111111]/70 leading-relaxed mb-8\" data-kid=\"2-6-2-2-4\" data-name=\"product description text\">\n                    Lana mixta de alto gramaje, forro interior térmico y botonadura de cuerno natural. Corte oversize, largo hasta la rodilla.\n                </p>\n                <button class=\"bg-[#111111] text-white text-sm uppercase tracking-wide py-4 w-full\" data-kid=\"2-6-2-2-5\" data-name=\"add to cart button\">\n                    Agregar al carrito\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- FOOTER -->\n    <footer class=\"max-w-[1440px] mx-auto px-8 md:px-14 py-16 border-t border-[#111111]/10 flex flex-col md:flex-row md:items-end justify-between gap-10\" data-kid=\"2-7\" data-name=\"footer section\">\n        <div data-kid=\"2-7-1\" data-name=\"footer brand container\">\n            <h2 class=\"font-serif-display text-3xl mb-3\" data-kid=\"2-7-1-1\" data-name=\"footer studio brand name\">\n                Vibra Studio\n            </h2>\n            <p class=\"text-sm text-[#111111]/60 max-w-sm\" data-kid=\"2-7-1-2\" data-name=\"footer brand description\">\n                Moda y estilo con identidad propia, para quienes buscan piezas atemporales.\n            </p>\n        </div>\n        <div class=\"flex gap-8 text-sm uppercase tracking-wide text-[#111111]/70\" data-kid=\"2-7-2\" data-name=\"footer social links container\">\n            <a class=\"underline-hover\" data-kid=\"2-7-2-1\" data-name=\"instagram link\" href=\"#\">\n                Instagram\n            </a>\n            <a class=\"underline-hover\" data-kid=\"2-7-2-2\" data-name=\"facebook link\" href=\"#\">\n                Facebook\n            </a>\n            <a class=\"underline-hover\" data-kid=\"2-7-2-3\" data-name=\"tiktok link\" href=\"#\">\n                TikTok\n            </a>\n        </div>\n    </footer>\n    <div class=\"text-center text-xs text-[#111111]/40 pb-8\" data-kid=\"2-8\" data-name=\"copyright notice text\">\n        © 2026 Vibra Studio — Todos los derechos reservados\n    </div>\n    <!-- WHATSAPP FAB -->\n    <a aria-label=\"Pedir por WhatsApp\" class=\"fab-jiggle fixed bottom-6 right-6 w-12 h-12 rounded-full bg-white border border-[#111111]/20 flex items-center justify-center shadow-[0_4px_14px_rgba(0,0,0,0.12)] z-40\" data-kid=\"2-9\" data-name=\"whatsapp floating action button\" href=\"#\">\n        <i class=\"ti ti-message-circle text-[20px] text-[#111111]\" data-kid=\"2-9-1\" data-name=\"whatsapp icon\">\n        </i>\n    </a>\n</div>\n",
