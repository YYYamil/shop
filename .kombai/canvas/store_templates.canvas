      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');\n:root{--ink:#111827;--muted:#667085;--paper:#f6f5ef;--white:#fffdf8;--line:#dddcd4;--lime:#c9f15e;--blue:#165dff;--pink:#ff16d9;--green:#3c8b54;}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;}\nimg{display:block;max-width:100%;}\n.landing-shell{overflow:hidden;background:var(--paper);}\n.container{width:min(1160px,calc(100% - 64px));margin:0 auto;}\n.navbar{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(17,24,39,.12);}\n.brand{display:flex;align-items:center;gap:9px;font-family:'Manrope',sans-serif;font-weight:800;font-size:20px;letter-spacing:-.04em;}\n.brand-mark{width:30px;height:30px;background:var(--ink);color:var(--lime);display:grid;place-items:center;border-radius:9px;font-size:13px;}\n.nav-links{display:flex;align-items:center;gap:28px;color:#596273;font-size:13px;font-weight:600;}\n.nav-links span{white-space:nowrap;}\n.nav-cta{background:var(--ink);color:#fff;padding:12px 18px;border-radius:999px;font-weight:700;font-size:13px;}\n.eyebrow{font-size:11px;line-height:1;letter-spacing:.18em;text-transform:uppercase;color:#58667a;font-weight:700;}\n.hero{padding:78px 0 92px;position:relative;}\n.hero-grid{display:grid;grid-template-columns:1fr .95fr;gap:74px;align-items:center;}\n.hero-copy{max-width:570px;}\n.hero h1{font-family:'Manrope',sans-serif;font-size:clamp(48px,5.5vw,78px);line-height:1.01;letter-spacing:-.075em;margin:22px 0 24px;font-weight:800;}\n.hero h1 em{font-style:normal;text-decoration:underline;text-decoration-thickness:5px;text-decoration-color:var(--lime);text-underline-offset:8px;}\n.hero-lede{max-width:500px;font-size:19px;color:#536071;line-height:1.5;margin:0 0 30px;}\n.cta-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}\n.btn-dark{display:inline-flex;align-items:center;justify-content:center;background:var(--ink);color:white;border-radius:999px;padding:15px 23px;text-decoration:none;font-weight:700;font-size:14px;}\n.btn-light{display:inline-flex;align-items:center;justify-content:center;border:1px solid #aeb4be;color:var(--ink);border-radius:999px;padding:14px 22px;text-decoration:none;font-weight:700;font-size:14px;background:transparent;}\n.hero-note{margin-top:28px;display:flex;align-items:center;gap:12px;color:#6d7683;font-size:12px;}\n.hero-note strong{color:var(--ink);font-weight:700;}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block;}\n.hero-proof{display:flex;gap:10px;flex-wrap:wrap;margin-top:32px;}\n.proof-pill{border:1px solid var(--line);background:rgba(255,253,248,.65);padding:8px 11px;border-radius:999px;font-size:11px;color:#525e6d;}\n.proof-pill b{color:var(--ink);font-weight:700;}\n.hero-visual{position:relative;min-height:570px;display:flex;align-items:center;justify-content:center;}\n.hero-visual::before{content:'';position:absolute;width:480px;height:480px;border-radius:50%;background:#e2e7d5;right:-48px;top:34px;}\n.hero-visual::after{content:'EJEMPLO REAL';position:absolute;right:5px;top:24px;writing-mode:vertical-rl;font-size:10px;letter-spacing:.2em;color:#7d887d;font-weight:700;}\n.hero-image{position:relative;width:350px;height:570px;object-fit:cover;object-position:center top;filter:drop-shadow(22px 28px 30px rgba(16,24,40,.22));}\n.hero-label{position:absolute;bottom:15px;left:22px;z-index:2;background:var(--white);padding:14px 17px;border:1px solid var(--line);box-shadow:0 14px 34px rgba(17,24,39,.12);}\n.hero-label b{font-family:'Manrope',sans-serif;font-size:14px;display:block;letter-spacing:-.02em;}\n.hero-label span{font-size:11px;color:var(--muted);display:block;margin-top:3px;}\n.proof-bar{background:var(--ink);color:#fff;padding:21px 0;}\n.proof-bar-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;}\n.proof-bar strong{font-family:'Manrope',sans-serif;font-size:20px;letter-spacing:-.04em;}\n.proof-bar p{margin:0;color:#b9c1cf;font-size:13px;max-width:450px;}\n.proof-bar .mini-list{display:flex;gap:20px;color:var(--lime);font-size:11px;font-weight:700;white-space:nowrap;}\n.section{padding:108px 0;}\n.section-heading{max-width:660px;margin-bottom:50px;}\n.section-heading h2{font-family:'Manrope',sans-serif;letter-spacing:-.065em;font-size:clamp(34px,4vw,58px);line-height:1.04;margin:17px 0 15px;}\n.section-heading p{font-size:17px;color:var(--muted);max-width:560px;margin:0;}\n.flow-section{background:#fffdf8;}\n.flow-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:start;}\n.flow-intro{position:sticky;top:28px;}\n.flow-intro h2{font-family:'Manrope',sans-serif;font-size:52px;line-height:1.03;letter-spacing:-.07em;margin:17px 0;}\n.flow-intro p{font-size:17px;color:var(--muted);max-width:400px;}\n.flow-line{position:relative;padding-left:52px;}\n.flow-line::before{content:'';position:absolute;left:18px;top:28px;bottom:28px;width:1px;background:#b8c0c6;}\n.flow-step{position:relative;display:grid;grid-template-columns:82px 1fr;gap:20px;align-items:start;padding:0 0 42px;}\n.flow-step:last-child{padding-bottom:0;}\n.step-num{position:absolute;left:-52px;top:0;width:38px;height:38px;border:1px solid var(--ink);border-radius:50%;display:grid;place-items:center;background:var(--white);font-family:'Manrope',sans-serif;font-weight:800;font-size:14px;z-index:1;}\n.flow-step img{width:82px;height:126px;object-fit:cover;object-position:center top;border-radius:14px;border:1px solid #d3d4ce;background:#ecebe5;}\n.flow-step:nth-child(3) img{object-position:center 23%;}\n.flow-step:nth-child(4) img{object-position:center top;}\n.step-copy h3{font-family:'Manrope',sans-serif;font-size:20px;letter-spacing:-.04em;margin:2px 0 7px;}\n.step-copy p{font-size:13px;color:var(--muted);margin:0;max-width:310px;}\n.step-tag{display:inline-block;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#6e7888;font-weight:700;margin-bottom:6px;}\n.styles-section{background:var(--ink);color:white;}\n.styles-section .eyebrow{color:var(--lime);}\n.styles-section .section-heading p{color:#adb7c5;}\n.styles-grid{display:grid;grid-template-columns:1.1fr .8fr .8fr;gap:18px;align-items:start;}\n.style-tile{position:relative;overflow:hidden;background:#222c3b;min-height:420px;}\n.style-tile img{width:100%;height:100%;object-fit:cover;}\n.style-tile.large{height:560px;}\n.style-tile.medium{height:430px;margin-top:65px;}\n.style-tile.small{height:350px;margin-top:135px;}\n.style-tile.large img{object-position:center top;}\n.style-tile.medium img{object-position:center top;}\n.style-tile.small img{object-position:center top;}\n.style-caption{position:absolute;bottom:0;left:0;right:0;padding:55px 22px 20px;background:linear-gradient(transparent,rgba(0,0,0,.82));}\n.style-caption b{font-family:'Manrope',sans-serif;font-size:20px;display:block;letter-spacing:-.04em;}\n.style-caption span{font-size:11px;color:#d7dde5;display:block;margin-top:4px;}\n.admin-section{background:#eef0ed;}\n.admin-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:46px;align-items:center;}\n.admin-copy h2{font-family:'Manrope',sans-serif;font-size:52px;line-height:1.04;letter-spacing:-.07em;margin:17px 0 16px;}\n.admin-copy p{color:var(--muted);font-size:17px;max-width:425px;}\n.admin-checks{display:grid;gap:10px;margin-top:28px;}\n.admin-check{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;}\n.admin-check i{font-style:normal;width:22px;height:22px;border-radius:50%;background:var(--ink);color:var(--lime);display:grid;place-items:center;font-size:12px;}\n.admin-visual{display:grid;grid-template-columns:1fr 1.25fr;gap:14px;align-items:start;}\n.admin-visual img{border-radius:16px;border:1px solid #d8dcd7;box-shadow:0 16px 30px rgba(17,24,39,.12);background:#fff;}\n.admin-visual .admin-main{grid-row:span 2;align-self:center;}\n.admin-visual .admin-small{height:190px;object-fit:cover;object-position:center top;}\n.cap-section{background:var(--white);}\n.cap-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);}\n.cap{padding:26px 22px 30px;border-right:1px solid var(--line);min-height:180px;}\n.cap:last-child{border-right:0;}\n.cap-num{font-family:'Manrope',sans-serif;font-size:13px;color:#8a929e;}\n.cap h3{font-family:'Manrope',sans-serif;font-size:22px;letter-spacing:-.04em;margin:36px 0 8px;}\n.cap p{font-size:13px;color:var(--muted);margin:0;}\n.pricing-section{background:#e7eadf;}\n.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-items:stretch;}\n.price-card{background:var(--white);border:1px solid #d4d8ce;padding:30px 25px;min-height:300px;display:flex;flex-direction:column;}\n.price-card.featured{background:var(--ink);color:white;border-color:var(--ink);transform:translateY(-14px);}\n.price-card .tag{font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:#687487;font-weight:700;min-height:16px;}\n.price-card.featured .tag{color:var(--lime);}\n.price-card h3{font-family:'Manrope',sans-serif;font-size:22px;letter-spacing:-.04em;margin:22px 0 7px;}\n.price-card p{font-size:13px;color:var(--muted);margin:0 0 22px;}\n.price-card.featured p{color:#aab4c2;}\n.price{font-family:'Manrope',sans-serif;font-size:41px;letter-spacing:-.07em;margin-bottom:20px;}\n.price small{font-family:'DM Sans',sans-serif;font-size:12px;letter-spacing:0;color:#717a88;font-weight:500;}\n.price-card ul{list-style:none;padding:0;margin:0 0 24px;display:grid;gap:9px;flex:1;font-size:13px;color:#4e5867;}\n.price-card.featured ul{color:#d8dee8;}\n.price-card li::before{content:'✓';color:var(--green);font-weight:800;margin-right:8px;}\n.price-card .btn-dark{border-radius:6px;text-align:center;}\n.price-card.featured .btn-dark{background:var(--lime);color:var(--ink);}\n.case-section{background:var(--paper);}\n.case-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:55px;align-items:center;}\n.case-image{width:100%;max-height:540px;object-fit:cover;object-position:center top;border:1px solid #d7d8d1;box-shadow:18px 22px 0 #dce1d5;}\n.case-copy h2{font-family:'Manrope',sans-serif;font-size:51px;line-height:1.03;letter-spacing:-.07em;margin:17px 0;}\n.case-copy p{font-size:17px;color:var(--muted);max-width:470px;}\n.case-facts{display:flex;flex-wrap:wrap;gap:9px;margin-top:25px;}\n.case-fact{font-size:11px;font-weight:700;border:1px solid #c9cdc4;padding:9px 11px;background:#fffdf8;}\n.faq-section{background:var(--white);}\n.faq-grid{max-width:850px;margin:0 auto;border-top:1px solid var(--line);}\n.faq-item{display:flex;align-items:center;justify-content:space-between;padding:20px 0;border-bottom:1px solid var(--line);font-family:'Manrope',sans-serif;font-size:17px;letter-spacing:-.02em;}\n.faq-item span{font-family:'DM Sans',sans-serif;color:#7c8694;font-size:18px;}\n.final-cta{padding:100px 0;background:var(--ink);color:white;}\n.final-inner{display:flex;align-items:end;justify-content:space-between;gap:35px;}\n.final-cta h2{font-family:'Manrope',sans-serif;font-size:clamp(42px,5vw,72px);line-height:1;letter-spacing:-.075em;margin:17px 0 0;max-width:650px;}\n.final-cta p{font-size:16px;color:#b9c2cf;max-width:370px;margin:0 0 3px;}\n.footer{background:#0c111b;color:#96a1b2;padding:28px 0;font-size:12px;}\n.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;}\n.footer .brand{color:#fff;font-size:16px;}\n.footer .brand-mark{width:24px;height:24px;font-size:10px;background:#273244;}\n@media(max-width:900px){.container{width:min(100% - 36px,680px);}.nav-links{display:none;}.hero{padding-top:45px;}.hero-grid,.flow-grid,.admin-grid,.case-grid{grid-template-columns:1fr;gap:45px;}.hero-visual{min-height:540px;order:-1;}.hero-image{width:300px;height:500px;}.hero-visual::before{width:380px;height:380px;right:calc(50% - 190px);}.hero-visual::after{right:calc(50% - 190px);}.hero-label{left:calc(50% - 140px);}.flow-intro{position:static;}.styles-grid{grid-template-columns:1fr 1fr;}.style-tile.large{grid-column:span 2;height:480px;}.style-tile.medium,.style-tile.small{margin-top:0;height:380px;}.admin-visual{grid-template-columns:1fr 1fr;}.admin-visual .admin-main{grid-column:span 2;grid-row:auto;}.cap-grid{grid-template-columns:1fr 1fr;}.cap:nth-child(2){border-right:0;}.cap:nth-child(1),.cap:nth-child(2){border-bottom:1px solid var(--line);}.price-grid{grid-template-columns:1fr;max-width:470px;margin:0 auto;}.price-card.featured{transform:none;order:-1;}.final-inner{display:block;}.final-cta p{margin-top:24px;}.proof-bar-inner{display:block;}.proof-bar .mini-list{margin-top:16px;flex-wrap:wrap;}.footer-inner{display:block;}.footer-inner>span{display:block;margin-top:14px;}}\n@media(max-width:560px){.section{padding:76px 0;}.hero h1{font-size:46px;}.hero-lede{font-size:17px;}.styles-grid{grid-template-columns:1fr;}.style-tile.large{grid-column:auto;height:500px;}.style-tile.medium,.style-tile.small{height:360px;}.flow-step{grid-template-columns:66px 1fr;gap:14px;}.flow-step img{width:66px;height:108px;}.cap-grid{grid-template-columns:1fr;}.cap{border-right:0!important;border-bottom:1px solid var(--line)!important;min-height:auto;}.cap:last-child{border-bottom:0!important;}.admin-visual{grid-template-columns:1fr;}.admin-visual .admin-main{grid-column:auto;}.admin-visual .admin-small{height:auto;}.case-image{box-shadow:10px 12px 0 #dce1d5;}.faq-item{font-size:15px;}.nav-cta{padding:11px 13px;font-size:12px;}}\n</style>\n<div class=\"landing-shell\" data-kid=\"1\" data-name=\"landing page layout container\">\n    <div class=\"container\" data-kid=\"1-1\" data-name=\"container layout wrapper\">\n        <nav class=\"navbar\" data-kid=\"1-1-1\" data-name=\"navigation bar\">\n            <div class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name container\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand symbol mark\">\n                    S\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Shop SaaS\n                </span>\n            </div>\n            <div class=\"nav-links\" data-kid=\"1-1-1-2\" data-name=\"navigation links container\">\n                <span data-kid=\"1-1-1-2-1\" data-name=\"real examples navigation link\">\n                    Ejemplos reales\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"how it works navigation link\">\n                    Cómo funciona\n                </span>\n                <span data-kid=\"1-1-1-2-3\" data-name=\"plans navigation link\">\n                    Planes\n                </span>\n                <span data-kid=\"1-1-1-2-4\" data-name=\"faq navigation link\">\n                    Preguntas\n                </span>\n            </div>\n            <span class=\"nav-cta\" data-kid=\"1-1-1-3\" data-name=\"primary call-to-action button\">\n                Crear mi tienda\n            </span>\n        </nav>\n    </div>\n    <header class=\"hero\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"container hero-grid\" data-kid=\"1-2-1\" data-name=\"hero content grid\">\n            <div class=\"hero-copy\" data-kid=\"1-2-1-1\" data-name=\"hero text content block\">\n                <div class=\"eyebrow\" data-kid=\"1-2-1-1-1\" data-name=\"hero eyebrow text\">\n                    <span class=\"dot\" data-kid=\"1-2-1-1-1-1\" data-name=\"decorative green dot\">\n                    </span>\n                    Plataforma multitienda · producto real\n                </div>\n                <h1 data-kid=\"1-2-1-1-2\" data-name=\"hero main headline\">\n                    Tu tienda online puede verse\n                    <em data-kid=\"1-2-1-1-2-1\" data-name=\"underlined highlighted text\">\n                        así.\n                    </em>\n                </h1>\n                <p class=\"hero-lede\" data-kid=\"1-2-1-1-3\" data-name=\"hero subheadline description\">\n                    Creá una tienda con identidad propia, catálogo, carrito y medios de pago. No es una maqueta: son ejemplos reales funcionando dentro de la plataforma.\n                </p>\n                <div class=\"cta-row\" data-kid=\"1-2-1-1-4\" data-name=\"hero call-to-action buttons row\">\n                    <span class=\"btn-dark\" data-kid=\"1-2-1-1-4-1\" data-name=\"create shop button\">\n                        Crear mi tienda gratis\n                    </span>\n                    <span class=\"btn-light\" data-kid=\"1-2-1-1-4-2\" data-name=\"view examples button\">\n                        Ver ejemplos reales\n                    </span>\n                </div>\n                <div class=\"hero-note\" data-kid=\"1-2-1-1-5\" data-name=\"hero social proof note\">\n                    <span class=\"dot\" data-kid=\"1-2-1-1-5-1\" data-name=\"decorative green dot\">\n                    </span>\n                    <span data-kid=\"1-2-1-1-5-2\" data-name=\"proof note description\">\n                        <strong data-kid=\"1-2-1-1-5-2-1\" data-name=\"proof note business name\">\n                            Glitter Show\n                        </strong>\n                        · ejemplo real de tienda mobile\n                    </span>\n                </div>\n                <div class=\"hero-proof\" data-kid=\"1-2-1-1-6\" data-name=\"hero features pills container\">\n                    <span class=\"proof-pill\" data-kid=\"1-2-1-1-6-1\" data-name=\"feature pill 1\">\n                        <b data-kid=\"1-2-1-1-6-1-1\" data-name=\"feature pill bold text 1\">\n                            Identidad\n                        </b>\n                        propia\n                    </span>\n                    <span class=\"proof-pill\" data-kid=\"1-2-1-1-6-2\" data-name=\"feature pill 2\">\n                        <b data-kid=\"1-2-1-1-6-2-1\" data-name=\"feature pill bold text 2\">\n                            Catálogo\n                        </b>\n                        visible\n                    </span>\n                    <span class=\"proof-pill\" data-kid=\"1-2-1-1-6-3\" data-name=\"feature pill 3\">\n                        <b data-kid=\"1-2-1-1-6-3-1\" data-name=\"feature pill bold text 3\">\n                            Compra\n                        </b>\n                        desde el celular\n                    </span>\n                </div>\n            </div>\n            <div class=\"hero-visual\" data-kid=\"1-2-1-2\" data-name=\"hero visual container\">\n                <img alt=\"Ejemplo real de tienda mobile Glitter Show\" class=\"hero-image\" data-kid=\"1-2-1-2-1\" data-name=\"hero showcase image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio1/mobile%20Diseno%20comercial/Screenshot_1.png\"/>\n                <div class=\"hero-label\" data-kid=\"1-2-1-2-2\" data-name=\"showcase image label overlay\">\n                    <b data-kid=\"1-2-1-2-2-1\" data-name=\"showcase label title\">\n                        Glitter Show\n                    </b>\n                    <span data-kid=\"1-2-1-2-2-2\" data-name=\"showcase label description\">\n                        Campaña · catálogo · carrito\n                    </span>\n                </div>\n            </div>\n        </div>\n    </header>\n    <section class=\"proof-bar\" data-kid=\"1-3\" data-name=\"proof banner section\">\n        <div class=\"container proof-bar-inner\" data-kid=\"1-3-1\" data-name=\"proof banner content container\">\n            <strong data-kid=\"1-3-1-1\" data-name=\"proof banner heading\">\n                La plataforma se adapta a tu marca.\n            </strong>\n            <p data-kid=\"1-3-1-2\" data-name=\"proof banner description\">\n                Una misma base para rubros, estilos y formas de vender diferentes.\n            </p>\n            <div class=\"mini-list\" data-kid=\"1-3-1-3\" data-name=\"mini list of features\">\n                <span data-kid=\"1-3-1-3-1\" data-name=\"list item 1\">\n                    TIENDAS REALES\n                </span>\n                <span data-kid=\"1-3-1-3-2\" data-name=\"list item 2\">\n                    CATÁLOGOS\n                </span>\n                <span data-kid=\"1-3-1-3-3\" data-name=\"list item 3\">\n                    CHECKOUT\n                </span>\n            </div>\n        </div>\n    </section>\n    <section class=\"section flow-section\" data-kid=\"1-4\" data-name=\"customer flow process section\">\n        <div class=\"container flow-grid\" data-kid=\"1-4-1\" data-name=\"flow process grid container\">\n            <div class=\"flow-intro\" data-kid=\"1-4-1-1\" data-name=\"flow introduction block\">\n                <div class=\"eyebrow\" data-kid=\"1-4-1-1-1\" data-name=\"flow eyebrow heading\">\n                    Experiencia de compra\n                </div>\n                <h2 data-kid=\"1-4-1-1-2\" data-name=\"flow main heading\">\n                    Mirá cómo compra tu cliente.\n                </h2>\n                <p data-kid=\"1-4-1-1-3\" data-name=\"flow description text\">\n                    Desde el catálogo hasta el pedido, cada paso ocurre dentro de una tienda clara y preparada para vender.\n                </p>\n                <span class=\"btn-light\" data-kid=\"1-4-1-1-4\" data-name=\"flow call-to-action button\">\n                    Recorrido real de compra\n                </span>\n            </div>\n            <div class=\"flow-line\" data-kid=\"1-4-1-2\" data-name=\"flow steps container\">\n                <div class=\"flow-step\" data-kid=\"1-4-1-2-1\" data-name=\"flow step 01 card\">\n                    <span class=\"step-num\" data-kid=\"1-4-1-2-1-1\" data-name=\"step number label\">\n                        01\n                    </span>\n                    <img alt=\"Catálogo mobile de Vibra Complementos\" data-kid=\"1-4-1-2-1-2\" data-name=\"step demonstration image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%204/mobile%20diseno%20clasico/catalogo%27.png\"/>\n                    <div class=\"step-copy\" data-kid=\"1-4-1-2-1-3\" data-name=\"step content container\">\n                        <span class=\"step-tag\" data-kid=\"1-4-1-2-1-3-1\" data-name=\"step feature tag\">\n                            Catálogo\n                        </span>\n                        <h3 data-kid=\"1-4-1-2-1-3-2\" data-name=\"step heading\">\n                            Explora productos y categorías.\n                        </h3>\n                        <p data-kid=\"1-4-1-2-1-3-3\" data-name=\"step description\">\n                            Cards con imágenes, nombre, precio, stock y una acción de compra clara.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flow-step\" data-kid=\"1-4-1-2-2\" data-name=\"flow step 02 card\">\n                    <span class=\"step-num\" data-kid=\"1-4-1-2-2-1\" data-name=\"step number label\">\n                        02\n                    </span>\n                    <img alt=\"Detalle de producto mobile de Vibra Complementos\" data-kid=\"1-4-1-2-2-2\" data-name=\"step demonstration image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%204/mobile%20diseno%20clasico/modalproducto.png\"/>\n                    <div class=\"step-copy\" data-kid=\"1-4-1-2-2-3\" data-name=\"step content container\">\n                        <span class=\"step-tag\" data-kid=\"1-4-1-2-2-3-1\" data-name=\"step feature tag\">\n                            Detalle de producto\n                        </span>\n                        <h3 data-kid=\"1-4-1-2-2-3-2\" data-name=\"step heading\">\n                            Consulta lo que importa.\n                        </h3>\n                        <p data-kid=\"1-4-1-2-2-3-3\" data-name=\"step description\">\n                            Imagen, descripción, stock y precio en una vista enfocada antes de agregar al carrito.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flow-step\" data-kid=\"1-4-1-2-3\" data-name=\"flow step 03 card\">\n                    <span class=\"step-num\" data-kid=\"1-4-1-2-3-1\" data-name=\"step number label\">\n                        03\n                    </span>\n                    <img alt=\"Carrito mobile de Glitter Show\" data-kid=\"1-4-1-2-3-2\" data-name=\"step demonstration image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio1/mobile%20Diseno%20comercial/Screenshot_3.png\"/>\n                    <div class=\"step-copy\" data-kid=\"1-4-1-2-3-3\" data-name=\"step content container\">\n                        <span class=\"step-tag\" data-kid=\"1-4-1-2-3-3-1\" data-name=\"step feature tag\">\n                            Carrito\n                        </span>\n                        <h3 data-kid=\"1-4-1-2-3-3-2\" data-name=\"step heading\">\n                            Revisa cantidades y subtotales.\n                        </h3>\n                        <p data-kid=\"1-4-1-2-3-3-3\" data-name=\"step description\">\n                            El cliente tiene una vista clara de sus productos antes de enviar el pedido.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flow-step\" data-kid=\"1-4-1-2-4\" data-name=\"flow step 04 card\">\n                    <span class=\"step-num\" data-kid=\"1-4-1-2-4-1\" data-name=\"step number label\">\n                        04\n                    </span>\n                    <img alt=\"Checkout mobile con Mercado Pago y WhatsApp de Tukito\" data-kid=\"1-4-1-2-4-2\" data-name=\"step demonstration image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%203/mobile/compraConmercadoPago.png\"/>\n                    <div class=\"step-copy\" data-kid=\"1-4-1-2-4-3\" data-name=\"step content container\">\n                        <span class=\"step-tag\" data-kid=\"1-4-1-2-4-3-1\" data-name=\"step feature tag\">\n                            Mercado Pago / WhatsApp\n                        </span>\n                        <h3 data-kid=\"1-4-1-2-4-3-2\" data-name=\"step heading\">\n                            Elige cómo completar el pedido.\n                        </h3>\n                        <p data-kid=\"1-4-1-2-4-3-3\" data-name=\"step description\">\n                            Una experiencia mobile con datos del comprador y dos caminos de contacto o pago.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"section styles-section\" data-kid=\"1-5\" data-name=\"styles showcase section\">\n        <div class=\"container\" data-kid=\"1-5-1\" data-name=\"styles showcase grid container\">\n            <div class=\"section-heading\" data-kid=\"1-5-1-1\" data-name=\"styles section heading block\">\n                <div class=\"eyebrow\" data-kid=\"1-5-1-1-1\" data-name=\"styles eyebrow heading\">\n                    Ejemplos reales\n                </div>\n                <h2 data-kid=\"1-5-1-1-2\" data-name=\"styles main heading\">\n                    Un estilo para cada rubro.\n                </h2>\n                <p data-kid=\"1-5-1-1-3\" data-name=\"styles description text\">\n                    La tienda puede tener una estética editorial, comercial, creativa o de moda. El resultado no tiene por qué verse igual al de otro negocio.\n                </p>\n            </div>\n            <div class=\"styles-grid\" data-kid=\"1-5-1-2\" data-name=\"styles tiles grid\">\n                <div class=\"style-tile large\" data-kid=\"1-5-1-2-1\" data-name=\"large style showcase tile\">\n                    <img alt=\"Tienda mobile real de Vibra Complementos\" data-kid=\"1-5-1-2-1-1\" data-name=\"style tile image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%204/mobile%20diseno%20clasico/principal.png\"/>\n                    <div class=\"style-caption\" data-kid=\"1-5-1-2-1-2\" data-name=\"style tile caption\">\n                        <b data-kid=\"1-5-1-2-1-2-1\" data-name=\"style category title\">\n                            Moda y complementos\n                        </b>\n                        <span data-kid=\"1-5-1-2-1-2-2\" data-name=\"style description\">\n                            Vibra · color, textiles y catálogo mobile\n                        </span>\n                    </div>\n                </div>\n                <div class=\"style-tile medium\" data-kid=\"1-5-1-2-2\" data-name=\"medium style showcase tile\">\n                    <img alt=\"Tienda desktop real de Tukito\" data-kid=\"1-5-1-2-2-1\" data-name=\"style tile image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio%203/pc%20Diseno%20clasico/principal.png\"/>\n                    <div class=\"style-caption\" data-kid=\"1-5-1-2-2-2\" data-name=\"style tile caption\">\n                        <b data-kid=\"1-5-1-2-2-2-1\" data-name=\"style category title\">\n                            Productos creativos\n                        </b>\n                        <span data-kid=\"1-5-1-2-2-2-2\" data-name=\"style description\">\n                            Tukito · categorías y novedades\n                        </span>\n                    </div>\n                </div>\n                <div class=\"style-tile small\" data-kid=\"1-5-1-2-3\" data-name=\"small style showcase tile\">\n                    <img alt=\"Tienda mobile real de Glitter Show\" data-kid=\"1-5-1-2-3-1\" data-name=\"style tile image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio1/mobile%20Diseno%20comercial/Screenshot_1.png\"/>\n                    <div class=\"style-caption\" data-kid=\"1-5-1-2-3-2\" data-name=\"style tile caption\">\n                        <b data-kid=\"1-5-1-2-3-2-1\" data-name=\"style category title\">\n                            Fiestas y servicios\n                        </b>\n                        <span data-kid=\"1-5-1-2-3-2-2\" data-name=\"style description\">\n                            Glitter Show · campaña y conversión\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"section admin-section\" data-kid=\"1-6\" data-name=\"admin panel section\">\n        <div class=\"container admin-grid\" data-kid=\"1-6-1\" data-name=\"admin section grid\">\n            <div class=\"admin-copy\" data-kid=\"1-6-1-1\" data-name=\"admin description content\">\n                <div class=\"eyebrow\" data-kid=\"1-6-1-1-1\" data-name=\"admin eyebrow heading\">\n                    Desde tu panel\n                </div>\n                <h2 data-kid=\"1-6-1-1-2\" data-name=\"admin main heading\">\n                    La tienda se administra desde un solo lugar.\n                </h2>\n                <p data-kid=\"1-6-1-1-3\" data-name=\"admin description text\">\n                    Las capturas muestran el trabajo detrás del resultado: productos, categorías, stock, logo, colores e imagen de portada.\n                </p>\n                <div class=\"admin-checks\" data-kid=\"1-6-1-1-4\" data-name=\"admin feature list\">\n                    <div class=\"admin-check\" data-kid=\"1-6-1-1-4-1\" data-name=\"admin feature list item 1\">\n                        <i data-kid=\"1-6-1-1-4-1-1\" data-name=\"checkmark icon\">\n                            ✓\n                        </i>\n                        Productos, precios y stock\n                    </div>\n                    <div class=\"admin-check\" data-kid=\"1-6-1-1-4-2\" data-name=\"admin feature list item 2\">\n                        <i data-kid=\"1-6-1-1-4-2-1\" data-name=\"checkmark icon\">\n                            ✓\n                        </i>\n                        Categorías visibles en tu tienda\n                    </div>\n                    <div class=\"admin-check\" data-kid=\"1-6-1-1-4-3\" data-name=\"admin feature list item 3\">\n                        <i data-kid=\"1-6-1-1-4-3-1\" data-name=\"checkmark icon\">\n                            ✓\n                        </i>\n                        Logo, portada y colores propios\n                    </div>\n                </div>\n            </div>\n            <div class=\"admin-visual\" data-kid=\"1-6-1-2\" data-name=\"admin visual showcase\">\n                <img alt=\"Panel real de personalización de la tienda\" class=\"admin-main\" data-kid=\"1-6-1-2-1\" data-name=\"main admin dashboard screenshot\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/adminDash/Screenshot_3.png\"/>\n                <img alt=\"Panel real de productos con precio y stock\" class=\"admin-small\" data-kid=\"1-6-1-2-2\" data-name=\"admin products screenshot\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/adminDash/Screenshot_1.png\"/>\n                <img alt=\"Panel real de categorías y visibilidad\" class=\"admin-small\" data-kid=\"1-6-1-2-3\" data-name=\"admin categories screenshot\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/adminDash/Screenshot_2.png\"/>\n            </div>\n        </div>\n    </section>\n    <section class=\"section cap-section\" data-kid=\"1-7\" data-name=\"platform capabilities section\">\n        <div class=\"container\" data-kid=\"1-7-1\" data-name=\"capabilities section container\">\n            <div class=\"section-heading\" data-kid=\"1-7-1-1\" data-name=\"capabilities section heading block\">\n                <div class=\"eyebrow\" data-kid=\"1-7-1-1-1\" data-name=\"capabilities eyebrow heading\">\n                    Una plataforma, cuatro objetivos\n                </div>\n                <h2 data-kid=\"1-7-1-1-2\" data-name=\"capabilities main heading\">\n                    Todo lo que pasa antes y después del clic.\n                </h2>\n                <p data-kid=\"1-7-1-1-3\" data-name=\"capabilities description text\">\n                    Las capacidades aparecen organizadas por el trabajo real de quien vende online.\n                </p>\n            </div>\n            <div class=\"cap-grid\" data-kid=\"1-7-1-2\" data-name=\"capabilities grid\">\n                <div class=\"cap\" data-kid=\"1-7-1-2-1\" data-name=\"capability 01 card\">\n                    <div class=\"cap-num\" data-kid=\"1-7-1-2-1-1\" data-name=\"capability number label\">\n                        01\n                    </div>\n                    <h3 data-kid=\"1-7-1-2-1-2\" data-name=\"capability title\">\n                        Vender\n                    </h3>\n                    <p data-kid=\"1-7-1-2-1-3\" data-name=\"capability description\">\n                        Mostrá productos, categorías, precios, stock y promociones con una tienda que represente tu marca.\n                    </p>\n                </div>\n                <div class=\"cap\" data-kid=\"1-7-1-2-2\" data-name=\"capability 02 card\">\n                    <div class=\"cap-num\" data-kid=\"1-7-1-2-2-1\" data-name=\"capability number label\">\n                        02\n                    </div>\n                    <h3 data-kid=\"1-7-1-2-2-2\" data-name=\"capability title\">\n                        Cobrar\n                    </h3>\n                    <p data-kid=\"1-7-1-2-2-3\" data-name=\"capability description\">\n                        Ofrecé caminos concretos para completar el pedido, como Mercado Pago o WhatsApp.\n                    </p>\n                </div>\n                <div class=\"cap\" data-kid=\"1-7-1-2-3\" data-name=\"capability 03 card\">\n                    <div class=\"cap-num\" data-kid=\"1-7-1-2-3-1\" data-name=\"capability number label\">\n                        03\n                    </div>\n                    <h3 data-kid=\"1-7-1-2-3-2\" data-name=\"capability title\">\n                        Administrar\n                    </h3>\n                    <p data-kid=\"1-7-1-2-3-3\" data-name=\"capability description\">\n                        Organizá catálogo, categorías, visibilidad y disponibilidad desde tu panel.\n                    </p>\n                </div>\n                <div class=\"cap\" data-kid=\"1-7-1-2-4\" data-name=\"capability 04 card\">\n                    <div class=\"cap-num\" data-kid=\"1-7-1-2-4-1\" data-name=\"capability number label\">\n                        04\n                    </div>\n                    <h3 data-kid=\"1-7-1-2-4-2\" data-name=\"capability title\">\n                        Crecer\n                    </h3>\n                    <p data-kid=\"1-7-1-2-4-3\" data-name=\"capability description\">\n                        Presentá una experiencia más clara y profesional a medida que tu negocio suma productos.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"section pricing-section\" data-kid=\"1-8\" data-name=\"pricing plans section\">\n        <div class=\"container\" data-kid=\"1-8-1\" data-name=\"pricing section container\">\n            <div class=\"section-heading\" data-kid=\"1-8-1-1\" data-name=\"pricing section heading block\">\n                <div class=\"eyebrow\" data-kid=\"1-8-1-1-1\" data-name=\"pricing eyebrow heading\">\n                    Planes\n                </div>\n                <h2 data-kid=\"1-8-1-1-2\" data-name=\"pricing main heading\">\n                    Elegí cómo empezar.\n                </h2>\n                <p data-kid=\"1-8-1-1-3\" data-name=\"pricing description text\">\n                    Una propuesta simple para probar la plataforma y avanzar cuando tu negocio lo necesite.\n                </p>\n            </div>\n            <div class=\"price-grid\" data-kid=\"1-8-1-2\" data-name=\"pricing plans grid\">\n                <div class=\"price-card\" data-kid=\"1-8-1-2-1\" data-name=\"free pricing card\">\n                    <div class=\"tag\" data-kid=\"1-8-1-2-1-1\" data-name=\"pricing plan tag\">\n                        Para comenzar\n                    </div>\n                    <h3 data-kid=\"1-8-1-2-1-2\" data-name=\"plan name\">\n                        Emprendedor\n                    </h3>\n                    <p data-kid=\"1-8-1-2-1-3\" data-name=\"plan description\">\n                        Para probar tu primera tienda.\n                    </p>\n                    <div class=\"price\" data-kid=\"1-8-1-2-1-4\" data-name=\"plan price\">\n                        Gratis\n                    </div>\n                    <ul data-kid=\"1-8-1-2-1-5\" data-name=\"plan features list\">\n                        <li data-kid=\"1-8-1-2-1-5-1\" data-name=\"list item 1\">\n                            Tienda online completa\n                        </li>\n                        <li data-kid=\"1-8-1-2-1-5-2\" data-name=\"list item 2\">\n                            Productos ilimitados\n                        </li>\n                        <li data-kid=\"1-8-1-2-1-5-3\" data-name=\"list item 3\">\n                            Carrito de compras\n                        </li>\n                        <li data-kid=\"1-8-1-2-1-5-4\" data-name=\"list item 4\">\n                            Diseño personalizable\n                        </li>\n                    </ul>\n                    <span class=\"btn-light\" data-kid=\"1-8-1-2-1-6\" data-name=\"plan call-to-action button\">\n                        Empezar gratis\n                    </span>\n                </div>\n                <div class=\"price-card featured\" data-kid=\"1-8-1-2-2\" data-name=\"featured professional pricing card\">\n                    <div class=\"tag\" data-kid=\"1-8-1-2-2-1\" data-name=\"pricing plan tag\">\n                        Más elegido\n                    </div>\n                    <h3 data-kid=\"1-8-1-2-2-2\" data-name=\"plan name\">\n                        Profesional\n                    </h3>\n                    <p data-kid=\"1-8-1-2-2-3\" data-name=\"plan description\">\n                        Para negocios que quieren crecer.\n                    </p>\n                    <div class=\"price\" data-kid=\"1-8-1-2-2-4\" data-name=\"plan price\">\n                        $5.000\n                        <small data-kid=\"1-8-1-2-2-4-1\" data-name=\"price period suffix\">\n                            /mes ARS\n                        </small>\n                    </div>\n                    <ul data-kid=\"1-8-1-2-2-5\" data-name=\"plan features list\">\n                        <li data-kid=\"1-8-1-2-2-5-1\" data-name=\"list item 1\">\n                            Todo lo del plan Emprendedor\n                        </li>\n                        <li data-kid=\"1-8-1-2-2-5-2\" data-name=\"list item 2\">\n                            Pagos con Mercado Pago\n                        </li>\n                        <li data-kid=\"1-8-1-2-2-5-3\" data-name=\"list item 3\">\n                            Promociones y ofertas\n                        </li>\n                        <li data-kid=\"1-8-1-2-2-5-4\" data-name=\"list item 4\">\n                            Gestión avanzada de pedidos\n                        </li>\n                    </ul>\n                    <span class=\"btn-dark\" data-kid=\"1-8-1-2-2-6\" data-name=\"plan call-to-action button\">\n                        Crear mi tienda\n                    </span>\n                </div>\n                <div class=\"price-card\" data-kid=\"1-8-1-2-3\" data-name=\"custom enterprise pricing card\">\n                    <div class=\"tag\" data-kid=\"1-8-1-2-3-1\" data-name=\"pricing plan tag\">\n                        A medida\n                    </div>\n                    <h3 data-kid=\"1-8-1-2-3-2\" data-name=\"plan name\">\n                        Empresarial\n                    </h3>\n                    <p data-kid=\"1-8-1-2-3-3\" data-name=\"plan description\">\n                        Para mayor volumen y necesidades específicas.\n                    </p>\n                    <div class=\"price\" data-kid=\"1-8-1-2-3-4\" data-name=\"plan price\">\n                        A medida\n                    </div>\n                    <ul data-kid=\"1-8-1-2-3-5\" data-name=\"plan features list\">\n                        <li data-kid=\"1-8-1-2-3-5-1\" data-name=\"list item 1\">\n                            Todo lo del plan Profesional\n                        </li>\n                        <li data-kid=\"1-8-1-2-3-5-2\" data-name=\"list item 2\">\n                            Múltiples usuarios\n                        </li>\n                        <li data-kid=\"1-8-1-2-3-5-3\" data-name=\"list item 3\">\n                            Reportes avanzados\n                        </li>\n                        <li data-kid=\"1-8-1-2-3-5-4\" data-name=\"list item 4\">\n                            Soporte prioritario\n                        </li>\n                    </ul>\n                    <span class=\"btn-light\" data-kid=\"1-8-1-2-3-6\" data-name=\"plan call-to-action button\">\n                        Consultar\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"section case-section\" data-kid=\"1-9\" data-name=\"case study section\">\n        <div class=\"container case-grid\" data-kid=\"1-9-1\" data-name=\"case study grid\">\n            <img alt=\"Detalle real de producto en la tienda Glitter Show\" class=\"case-image\" data-kid=\"1-9-1-1\" data-name=\"case study image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/capturas/sitiosEjemplos/sitio1/mobile%20Diseno%20comercial/Screenshot_2.png\"/>\n            <div class=\"case-copy\" data-kid=\"1-9-1-2\" data-name=\"case study description content\">\n                <div class=\"eyebrow\" data-kid=\"1-9-1-2-1\" data-name=\"case study eyebrow\">\n                    Una tienda real como referencia\n                </div>\n                <h2 data-kid=\"1-9-1-2-2\" data-name=\"case study main heading\">\n                    La promesa se puede ver.\n                </h2>\n                <p data-kid=\"1-9-1-2-3\" data-name=\"case study description text\">\n                    Glitter Show combina campaña, catálogo, detalle de producto y carrito en una experiencia pensada para vender desde el celular.\n                </p>\n                <div class=\"case-facts\" data-kid=\"1-9-1-2-4\" data-name=\"case study fact tags container\">\n                    <span class=\"case-fact\" data-kid=\"1-9-1-2-4-1\" data-name=\"fact tag 1\">\n                        Portada propia\n                    </span>\n                    <span class=\"case-fact\" data-kid=\"1-9-1-2-4-2\" data-name=\"fact tag 2\">\n                        Productos y stock\n                    </span>\n                    <span class=\"case-fact\" data-kid=\"1-9-1-2-4-3\" data-name=\"fact tag 3\">\n                        Detalle de producto\n                    </span>\n                    <span class=\"case-fact\" data-kid=\"1-9-1-2-4-4\" data-name=\"fact tag 4\">\n                        Carrito mobile\n                    </span>\n                </div>\n                <div class=\"cta-row\" data-kid=\"1-9-1-2-5\" data-name=\"case study call-to-action row\" style=\"margin-top:28px\">\n                    <span class=\"btn-dark\" data-kid=\"1-9-1-2-5-1\" data-name=\"case study call-to-action button\">\n                        Quiero crear algo así\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"section faq-section\" data-kid=\"1-10\" data-name=\"faq section\">\n        <div class=\"container\" data-kid=\"1-10-1\" data-name=\"faq content container\">\n            <div class=\"section-heading\" data-kid=\"1-10-1-1\" data-name=\"faq section heading block\" style=\"margin-left:auto;margin-right:auto;text-align:center\">\n                <div class=\"eyebrow\" data-kid=\"1-10-1-1-1\" data-name=\"faq eyebrow heading\">\n                    Preguntas frecuentes\n                </div>\n                <h2 data-kid=\"1-10-1-1-2\" data-name=\"faq main heading\">\n                    Antes de empezar.\n                </h2>\n                <p data-kid=\"1-10-1-1-3\" data-name=\"faq description text\" style=\"margin-left:auto;margin-right:auto\">\n                    Las respuestas que ayudan a tomar la decisión.\n                </p>\n            </div>\n            <div class=\"faq-grid\" data-kid=\"1-10-1-2\" data-name=\"faq items grid\">\n                <div class=\"faq-item\" data-kid=\"1-10-1-2-1\" data-name=\"faq question 1\">\n                    ¿Necesito saber programar?\n                    <span data-kid=\"1-10-1-2-1-1\" data-name=\"expand icon\">\n                        ＋\n                    </span>\n                </div>\n                <div class=\"faq-item\" data-kid=\"1-10-1-2-2\" data-name=\"faq question 2\">\n                    ¿Puedo personalizar colores, logo y portada?\n                    <span data-kid=\"1-10-1-2-2-1\" data-name=\"expand icon\">\n                        ＋\n                    </span>\n                </div>\n                <div class=\"faq-item\" data-kid=\"1-10-1-2-3\" data-name=\"faq question 3\">\n                    ¿Cómo reciben los pagos mis clientes?\n                    <span data-kid=\"1-10-1-2-3-1\" data-name=\"expand icon\">\n                        ＋\n                    </span>\n                </div>\n                <div class=\"faq-item\" data-kid=\"1-10-1-2-4\" data-name=\"faq question 4\">\n                    ¿Puedo vender desde el celular?\n                    <span data-kid=\"1-10-1-2-4-1\" data-name=\"expand icon\">\n                        ＋\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"final-cta\" data-kid=\"1-11\" data-name=\"final call-to-action section\">\n        <div class=\"container final-inner\" data-kid=\"1-11-1\" data-name=\"final content container\">\n            <div data-kid=\"1-11-1-1\" data-name=\"final heading block\">\n                <div class=\"eyebrow\" data-kid=\"1-11-1-1-1\" data-name=\"final eyebrow heading\" style=\"color:var(--lime)\">\n                    Tu próximo paso\n                </div>\n                <h2 data-kid=\"1-11-1-1-2\" data-name=\"final main heading\">\n                    Convertí tu catálogo en una tienda propia.\n                </h2>\n            </div>\n            <div data-kid=\"1-11-1-2\" data-name=\"final description content\">\n                <p data-kid=\"1-11-1-2-1\" data-name=\"final description text\">\n                    Creá una experiencia real para tus clientes, con la identidad y los productos de tu negocio.\n                </p>\n                <span class=\"btn-dark\" data-kid=\"1-11-1-2-2\" data-name=\"final call-to-action button\" style=\"background:var(--lime);color:var(--ink);margin-top:23px\">\n                    Crear mi tienda gratis\n                </span>\n            </div>\n        </div>\n    </section>\n    <footer class=\"footer\" data-kid=\"1-12\" data-name=\"footer bar\">\n        <div class=\"container footer-inner\" data-kid=\"1-12-1\" data-name=\"footer inner content\">\n            <div class=\"brand\" data-kid=\"1-12-1-1\" data-name=\"footer brand container\">\n                <span class=\"brand-mark\" data-kid=\"1-12-1-1-1\" data-name=\"footer brand symbol mark\">\n                    S\n                </span>\n                <span data-kid=\"1-12-1-1-2\" data-name=\"footer brand name text\">\n                    Shop SaaS\n                </span>\n            </div>\n            <span data-kid=\"1-12-1-2\" data-name=\"footer description text\">\n                Plataforma multitienda para pymes y emprendedores · Ejemplos reales del producto\n            </span>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-09-11T17:39:29.930565+00:00",
      "modified": "2026-09-11T17:40:49.846168+00:00",
